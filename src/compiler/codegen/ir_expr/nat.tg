// src/compiler/codegen/ir_expr/nat.tg
// The driver never reaches this module: `run_compile` delegates codegen to the
// bootstrap binary, so it is compiled and type-checked but executed only by
// `test_ir_nat_div.tg`. See codegen/mod.tg (ADR 3.9.26a).
// `Nat` division and remainder (ADR 9.10.26g D3): the mirror of
// `compile_nat_div` / `compile_nat_mod` in
// `albite_codegen/src/codegen/data/ops/nat_ops.rs`.
//
// `n / 0` and `n % 0` are `0`, as the evaluator and the kernel say. A bare
// `udiv`/`urem` by zero is undefined in LLVM, so the divisor becomes
// `select(b == 0, 1, b)` first, branchless; `/` then selects `0` for a zero
// divisor (`a / 1` is `a`), and `%` needs nothing more (`a % 1` is `0`). Unlike
// the bootstrap this emitter does not special-case a constant divisor: it is
// unreachable, and the guard is correct for a constant too.

use elab::cir::types::{CodegenIR};
use codegen::ir_builder::{IRState, fresh_name, emit_line};
use codegen::ir_expr::{emit_expr};

/// Emit `select(divisor == 0, 1, divisor)`. Returns the zero test's name, the
/// safe divisor's name and the state.
fn emit_nonzero_divisor(st: IRState, divisor: String) -> (String, String, IRState) {
    let (is_zero, st) = fresh_name(st);
    let st = emit_line(st, "  " ++ is_zero ++ " = icmp eq i64 " ++ divisor ++ ", 0");
    let (safe, st) = fresh_name(st);
    let st = emit_line(st, "  " ++ safe ++ " = select i1 " ++ is_zero ++ ", i64 1, i64 " ++ divisor);
    (is_zero, safe, st)
}

/// Emit `a / b` for `Nat`: four lines, `0` for a zero divisor.
pub fn emit_nat_div(st: IRState, a: CodegenIR, b: CodegenIR) -> (String, IRState) {
    let (va, st) = emit_expr(st, a);
    let (vb, st) = emit_expr(st, b);
    let (is_zero, safe, st) = emit_nonzero_divisor(st, vb);
    let (quotient, st) = fresh_name(st);
    let st = emit_line(st, "  " ++ quotient ++ " = udiv i64 " ++ va ++ ", " ++ safe);
    let (result, st) = fresh_name(st);
    let st = emit_line(st, "  " ++ result ++ " = select i1 " ++ is_zero ++ ", i64 0, i64 " ++ quotient);
    (result, st)
}

/// Emit `a % b` for `Nat`: three lines, `0` for a zero divisor.
pub fn emit_nat_mod(st: IRState, a: CodegenIR, b: CodegenIR) -> (String, IRState) {
    let (va, st) = emit_expr(st, a);
    let (vb, st) = emit_expr(st, b);
    let (_is_zero, safe, st) = emit_nonzero_divisor(st, vb);
    let (result, st) = fresh_name(st);
    let st = emit_line(st, "  " ++ result ++ " = urem i64 " ++ va ++ ", " ++ safe);
    (result, st)
}
