// src/compiler/driver/cli/options/mod.tg
// Shared option parsing for check/run/compile commands: the LOOP.
//
// The state and its per-flag transitions are in `state.tg`; this file decides
// which transition each argument names, and drives them to exhaustion. The
// split is one-directional on purpose — `mod` reads `state`, never the reverse
// — because every helper used to tail-call `parse_options`, and splitting the
// file that way would have made the two modules mutually recursive.

use driver::ffi::{List, Nil, Cons};
use driver::ffi::types::{string_len};
use driver::util::{string_eq, starts_with, string_index_of_char};
use driver::util::strings::scalars::{string_copy_range};

pub mod state;
pub mod values;
pub use driver::cli::options::state::{ParseState, initial_state};

use driver::cli::options::state::{
    opt_exhausted, opt_verbose, opt_emit_llvm,
    opt_check_free_vars, opt_check_well_typed, opt_check_tyvar_escape,
    opt_skipped
};
use driver::cli::options::values::{
    opt_file, opt_dump_core, opt_dump_core_terms, opt_max_errors, opt_output,
    opt_error_format
};

/// Parse options from remaining arguments.
///
/// Each step consumes at least the head of `remaining`, and the two
/// value-consuming flags empty it outright when their argument is missing, so
/// the loop always reaches `Nil`.
// Partial (ADR 3.9.26h): the recursive call rebuilds its argument rather than
// passing a strict subterm — a measure recursion over `remaining`. Executable
// compiler code no proof reaches; E0063 guards that.
#[partial]
pub fn parse_options(state: ParseState) -> ParseState {
    match state.remaining {
        Nil() => state,
        Cons(arg, rest) => parse_options(dispatch_global_option(state, arg, rest))
    }
}

/// The diagnostic and codegen flags, then everything else.
///
/// Split in two so neither half approaches the cyclomatic gate: an `else if`
/// chain costs one decision per arm and this one has eleven.
fn dispatch_global_option(state: ParseState, arg: String, rest: List<String>) -> ParseState {
    if string_eq(arg, "-v") || string_eq(arg, "--verbose") {
        opt_verbose(state, rest)
    } else if string_eq(arg, "--emit-llvm") {
        opt_emit_llvm(state, rest)
    } else if string_eq(arg, "--check-free-vars") {
        opt_check_free_vars(state, rest)
    } else if string_eq(arg, "--check-well-typed") {
        opt_check_well_typed(state, rest)
    } else if string_eq(arg, "--check-tyvar-escape") {
        opt_check_tyvar_escape(state, rest)
    } else {
        dispatch_global_value_option(state, arg, rest)
    }
}

/// The flags that consume a value, the `--flag=value` form, and the two
/// positional fall-throughs.
fn dispatch_global_value_option(state: ParseState, arg: String, rest: List<String>) -> ParseState {
    if is_value_flag(arg) {
        take_value(state, arg, rest)
    } else if is_equals_form(arg) {
        dispatch_equals_form(state, arg, rest)
    } else if starts_with(arg, "-") {
        // Unknown option — skipped rather than rejected (could error).
        opt_skipped(state, rest)
    } else {
        opt_file(state, arg, rest)
    }
}

/// The flags whose value is a separate argument, or follows an `=`.
pub fn is_value_flag(arg: String) -> Bool {
    string_eq(arg, "--dump-core") || string_eq(arg, "--dump-core-terms") ||
        string_eq(arg, "--max-errors") || string_eq(arg, "--error-format") ||
        string_eq(arg, "-o") || string_eq(arg, "--output")
}

/// `--name=value`: a long flag with an `=` in it (ADR 30.9.26h D3).
fn is_equals_form(arg: String) -> Bool {
    starts_with(arg, "--") && string_index_of_char(arg, 61) < string_len(arg)
}

/// Split at the FIRST `=` and dispatch exactly as the spaced form would. An
/// unknown name is skipped WHOLE, value and all, as an unknown flag always
/// was — so `--foo=bar.tg` can never leak a positional file argument.
fn dispatch_equals_form(state: ParseState, arg: String, rest: List<String>) -> ParseState {
    let len = string_len(arg);
    let eq_at = string_index_of_char(arg, 61);
    let name = string_copy_range(arg, 0, eq_at);
    if is_value_flag(name) {
        apply_value(state, name, string_copy_range(arg, eq_at + 1, len), rest)
    } else {
        opt_skipped(state, rest)
    }
}

/// A flag whose value is the next argument.
///
/// One `match` on `rest` for all of them rather than one per flag: the missing
/// -argument case is the same everywhere and is the one that has to end the
/// loop, so writing it once per flag is that many chances to write it as "return the
/// state unchanged" and spin.
fn take_value(state: ParseState, arg: String, rest: List<String>) -> ParseState {
    match rest {
        Nil() => opt_exhausted(state),
        Cons(value, rest2) => apply_value(state, arg, value, rest2)
    }
}

/// Which field the value lands in.
fn apply_value(state: ParseState, arg: String, value: String, rest: List<String>) -> ParseState {
    if string_eq(arg, "--dump-core") {
        opt_dump_core(state, value, rest)
    } else if string_eq(arg, "--dump-core-terms") {
        opt_dump_core_terms(state, value, rest)
    } else if string_eq(arg, "--max-errors") {
        opt_max_errors(state, value, rest)
    } else if string_eq(arg, "--error-format") {
        // Its own arm: the final `else` is `--output`'s, so without this a
        // format value would silently become the output path.
        opt_error_format(state, value, rest)
    } else {
        opt_output(state, value, rest)
    }
}
