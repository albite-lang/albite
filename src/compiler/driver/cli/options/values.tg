// src/compiler/driver/cli/options/values.tg
// The value-carrying transitions: one per flag that stores a value, plus the
// positional file (ADR 30.9.26h). Moved out of `state.tg`, whose boolean
// transitions stay there, when `--error-format` added a field to every record
// and a fourteenth transition — the pair no longer fit under the .tg size cap.
//
// Same contract as `state.tg`: every function consumes its own arguments and
// returns; none recurses. The loop is `mod.tg`'s.

use driver::ffi::{List, Nil, Cons};
use parser::option::{Option, Some, None};
use driver::util::{parse_nat, option_unwrap_or, Result, Ok, Err};
use driver::cli::format::{ErrorFormat, error_format_from_flag};
use driver::cli::options::state::{ParseState};

/// A positional argument: the file. A later one wins.
pub fn opt_file(state: ParseState, arg: String, rest: List<String>) -> ParseState {
    {
        verbose: state.verbose,
        max_errors: state.max_errors,
        file: Some(arg),
        output: state.output,
        emit_llvm: state.emit_llvm,
        dump_core: state.dump_core,
        dump_core_terms: state.dump_core_terms,
        check_tyvar_escape: state.check_tyvar_escape,
        check_free_vars: state.check_free_vars,
        check_well_typed: state.check_well_typed,
        error_format: state.error_format,
        remaining: rest
    }
}

/// --dump-core PATTERN
pub fn opt_dump_core(state: ParseState, pattern: String, rest: List<String>) -> ParseState {
    {
        verbose: state.verbose,
        max_errors: state.max_errors,
        file: state.file,
        output: state.output,
        emit_llvm: state.emit_llvm,
        dump_core: Some(pattern),
        dump_core_terms: state.dump_core_terms,
        check_tyvar_escape: state.check_tyvar_escape,
        check_free_vars: state.check_free_vars,
        check_well_typed: state.check_well_typed,
        error_format: state.error_format,
        remaining: rest
    }
}

/// --dump-core-terms PATTERN
///
/// The machine-readable sibling of `--dump-core`: one `<name>\t<term>` line
/// per match, with no frame, which is what `albite diff selfhost-core`
/// consumes.
pub fn opt_dump_core_terms(state: ParseState, pattern: String, rest: List<String>) -> ParseState {
    {
        verbose: state.verbose,
        max_errors: state.max_errors,
        file: state.file,
        output: state.output,
        emit_llvm: state.emit_llvm,
        dump_core: state.dump_core,
        dump_core_terms: Some(pattern),
        check_tyvar_escape: state.check_tyvar_escape,
        check_free_vars: state.check_free_vars,
        check_well_typed: state.check_well_typed,
        error_format: state.error_format,
        remaining: rest
    }
}

/// --max-errors N (a value this parser cannot read falls back to 20)
pub fn opt_max_errors(state: ParseState, value: String, rest: List<String>) -> ParseState {
    {
        verbose: state.verbose,
        max_errors: option_unwrap_or(parse_nat(value), 20),
        file: state.file,
        output: state.output,
        emit_llvm: state.emit_llvm,
        dump_core: state.dump_core,
        dump_core_terms: state.dump_core_terms,
        check_tyvar_escape: state.check_tyvar_escape,
        check_free_vars: state.check_free_vars,
        check_well_typed: state.check_well_typed,
        error_format: state.error_format,
        remaining: rest
    }
}

/// -o / --output PATH
pub fn opt_output(state: ParseState, path: String, rest: List<String>) -> ParseState {
    {
        verbose: state.verbose,
        max_errors: state.max_errors,
        file: state.file,
        output: path,
        emit_llvm: state.emit_llvm,
        dump_core: state.dump_core,
        dump_core_terms: state.dump_core_terms,
        check_tyvar_escape: state.check_tyvar_escape,
        check_free_vars: state.check_free_vars,
        check_well_typed: state.check_well_typed,
        error_format: state.error_format,
        remaining: rest
    }
}

/// --error-format human|json. A value that is neither is KEPT as the error,
/// so the command parser can refuse it by name; a later valid one wins.
pub fn opt_error_format(state: ParseState, value: String, rest: List<String>) -> ParseState {
    {
        verbose: state.verbose,
        max_errors: state.max_errors,
        file: state.file,
        output: state.output,
        emit_llvm: state.emit_llvm,
        dump_core: state.dump_core,
        dump_core_terms: state.dump_core_terms,
        check_tyvar_escape: state.check_tyvar_escape,
        check_free_vars: state.check_free_vars,
        check_well_typed: state.check_well_typed,
        error_format: error_format_from_flag(value),
        remaining: rest
    }
}
