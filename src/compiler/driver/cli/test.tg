// src/compiler/driver/cli/test.tg
// CLI parsing for the `test` command.

use driver::ffi::{List, Nil, Cons};
use driver::ffi::types::{string_len};
use parser::option::{Option, Some, None};
use driver::util::{
    string_eq, starts_with, string_is_empty, parse_nat, option_unwrap_or,
    Result, Ok, Err
};
use driver::util::strings::scalars::{string_copy_range};
use driver::cli::{Command, CmdTest, CmdError, TestOpts, CliError};
use driver::cli::format::{TestFormat, TestFormatHuman, test_format_from_flag};

// ===========================================================================
// TEST COMMAND PARSING
// ===========================================================================

/// Parse `test` command arguments.
pub fn parse_test_command(args: List<String>) -> Command {
    let state = parse_test_options(args, "", "");
    let bad_flag: String = state.unknown_flag;
    if string_is_empty(bad_flag) {
        match state.format {
            // A bad `--format` value is refused by name, before the file is
            // looked for (ADR 1.10.26i D1), as `--error-format`'s is.
            Err(bad) => CmdError({
                message: "invalid value '" ++ bad ++ "' for --format (expected 'human', 'json' or 'junit')",
                usage: "albite test [--format human|json|junit] [OPTIONS] <FILE>"
            } : CliError),
            Ok(format) => test_command_for_file(state, format)
        }
    } else {
        // Reported BEFORE the missing-file check: a typo'd flag is the more
        // specific diagnosis, and it is the whole reason this arm exists.
        let err: CliError = {
            message: "unknown option: " ++ bad_flag,
            usage: "albite test [OPTIONS] <FILE>"
        };
        CmdError(err)
    }
}

/// The rest of `test`: the file is required.
fn test_command_for_file(state: TestParseState, format: TestFormat) -> Command {
    let file_str: String = state.file;
    if string_is_empty(file_str) {
        let err: CliError = {
            message: "missing required argument: <FILE>",
            usage: "albite test [OPTIONS] <FILE>"
        };
        CmdError(err)
    } else {
        let opts: TestOpts = {
            file: file_str,
            verbose: state.verbose,
            filter: state.filter,
            max_errors: state.max_errors,
            require_tests: state.require_tests,
            format: format
        };
        CmdTest(opts)
    }
}

/// Intermediate state for test option parsing.
///
/// `unknown_flag` is the error channel this record did not have (ADR 7.8.26a
/// D3). `parse_test_options` used to swallow every unrecognised `-` argument
/// silently, so the moment `--require-tests` existed,
/// `albite test f.tg --requre-tests` would have been accepted and ignored —
/// the flag that exists to prevent a vacuous green becoming a vacuous green by
/// typo, while looking armed. Empty means "no error", which is why
/// `parse_test_command` checks it first.
///
/// `format` keeps a refused value as its `Err`, so the command parser can name
/// it (ADR 1.10.26i D1).
pub type TestParseState = {
    file: String,
    verbose: Bool,
    filter: String,
    max_errors: Nat,
    require_tests: Bool,
    unknown_flag: String,
    format: Result<TestFormat, String>
}

/// The state an exhausted (or truncated) argument list yields.
pub fn empty_test_state(file: String, filter: String) -> TestParseState {
    { file: file, verbose: false, filter: filter, max_errors: 20,
      require_tests: false, unknown_flag: "", format: Ok(TestFormatHuman) } : TestParseState
}

// ---------------------------------------------------------------------------
// SINGLE-FIELD UPDATERS
//
// Every arm of `parse_test_options` used to respell all six fields to change
// one of them, so adding a seventh meant five edits and a missed one compiled
// silently — a record literal has no "and the rest unchanged" form here. These
// updaters are that form, written once. Each one names the field it owns, so
// the parser below reads as "this flag sets this field" and nothing else.
// ---------------------------------------------------------------------------

/// `s` with `verbose` set.
fn with_verbose(s: TestParseState) -> TestParseState {
    { file: s.file, verbose: true, filter: s.filter, max_errors: s.max_errors,
      require_tests: s.require_tests, unknown_flag: s.unknown_flag, format: s.format } : TestParseState
}

/// `s` with `require_tests` set.
fn with_require_tests(s: TestParseState) -> TestParseState {
    { file: s.file, verbose: s.verbose, filter: s.filter, max_errors: s.max_errors,
      require_tests: true, unknown_flag: s.unknown_flag, format: s.format } : TestParseState
}

/// `s` with `max_errors` replaced.
fn with_max_errors(s: TestParseState, n: Nat) -> TestParseState {
    { file: s.file, verbose: s.verbose, filter: s.filter, max_errors: n,
      require_tests: s.require_tests, unknown_flag: s.unknown_flag, format: s.format } : TestParseState
}

/// `s` with `unknown_flag` replaced.
///
/// Unconditional overwrite, which is what makes the FIRST unknown flag win:
/// the caller applies this on the way *out* of the recursion, over whatever the
/// tail recorded.
fn with_unknown_flag(s: TestParseState, flag: String) -> TestParseState {
    { file: s.file, verbose: s.verbose, filter: s.filter, max_errors: s.max_errors,
      require_tests: s.require_tests, unknown_flag: flag, format: s.format } : TestParseState
}

/// `s` with `format` read from `value` — an `Err` carrying it when refused.
fn with_format(s: TestParseState, value: String) -> TestParseState {
    { file: s.file, verbose: s.verbose, filter: s.filter, max_errors: s.max_errors,
      require_tests: s.require_tests, unknown_flag: s.unknown_flag,
      format: test_format_from_flag(value) } : TestParseState
}

/// Parse test command options recursively.
///
/// Each arm updates one field of the recursive result, so a flag seen early
/// survives the rest of the list.
pub fn parse_test_options(args: List<String>, file: String, filter: String) -> TestParseState {
    match args {
        Nil() => empty_test_state(file, filter),
        Cons(arg, rest) =>
            if string_eq(arg, "-v") || string_eq(arg, "--verbose") {
                with_verbose(parse_test_options(rest, file, filter))
            } else if string_eq(arg, "--require-tests") {
                with_require_tests(parse_test_options(rest, file, filter))
            } else if string_eq(arg, "--filter") {
                match rest {
                    Nil() => empty_test_state(file, filter),
                    Cons(f, rest2) => parse_test_options(rest2, file, f)
                }
            } else {
                parse_test_value_option(arg, rest, file, filter)
            }
    }
}

/// `--max-errors`, `--format` in both spellings, then the fall-throughs.
/// Split from `parse_test_options` so neither approaches the cyclomatic gate.
// Partial (ADR 11.8.26b): the descent on `rest` crosses this helper, whose
// own `rest` is not a subterm of ITS caller's root, so no call site passes a
// strict structural subterm. Executable code no proof reaches.
#[partial]
fn parse_test_value_option(arg: String, rest: List<String>, file: String,
                           filter: String) -> TestParseState {
    if string_eq(arg, "--max-errors") {
        match rest {
            Nil() => empty_test_state(file, filter),
            Cons(val, rest2) =>
                with_max_errors(parse_test_options(rest2, file, filter),
                                option_unwrap_or(parse_nat(val), 20))
        }
    } else if string_eq(arg, "--format") {
        match rest {
            Nil() => empty_test_state(file, filter),
            Cons(val, rest2) => with_format(parse_test_options(rest2, file, filter), val)
        }
    } else if starts_with(arg, "--format=") {
        with_format(parse_test_options(rest, file, filter),
                    string_copy_range(arg, 9, string_len(arg)))
    } else if starts_with(arg, "-") {
        with_unknown_flag(parse_test_options(rest, file, filter), arg)
    } else {
        parse_test_options(rest, arg, filter)
    }
}
