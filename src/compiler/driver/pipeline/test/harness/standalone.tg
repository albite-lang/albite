// src/compiler/driver/pipeline/test/harness/standalone.tg
// Standalone mode: self-contained externs, minus the assertion surface
// (ADR 7.8.26b D4/§2.2).
//
// D4 is the half of this ADR that is easy to miss: standalone mode was broken
// too. `tests/test_runner_allpass.tg` — the canonical standalone fixture —
// declares its OWN `extern "C" fn tg_assert_eq_nat` and its own
// `fn assert_eq_nat`, and the old preamble declared both again. The generator
// collided with the exemplar it was written for.
//
// The fix is the invariant's consequence rather than a special case:
// **the harness drops the assertion surface entirely.** `assert_eq_*` is the
// user's business; a test runner has no reason to define it. Three `tg_*`
// externs and three wrappers go with it, and `tg_print` — declared but never
// called — goes too. Eleven declarations become seven.
//
// Of those seven, only the ones the program does not already declare are
// emitted; `reused` carries the rest (arity-checked by `decide.tg`, because
// reusing a same-named declaration of a DIFFERENT arity would produce a type
// error behind the very wall this ADR removes).

use driver::ffi::{List, Nil, Cons};
use driver::util::{string_eq};
use driver::pipeline::test::harness::runner::{HarnessCalls};
use driver::pipeline::test::mode::types::{ExternNeed, standalone_extern_needs};
use driver::pipeline::test::mode::decide::{list_has_name};
use driver::cli::format::{TestFormat, test_format_is_machine};

pub fn standalone_calls() -> HarnessCalls {
    {
        test_begin: "_harness_test_begin",
        test_check_failure: "tg_test_check_failure",
        nat_to_string: "_harness_nat_to_string",
        exit_fn: "tg_exit",
        record_begin: "",
        record_end: ""
    } : HarnessCalls
}

/// The machine-format call forms (ADR 1.10.26i D7): the human table plus the
/// record bracket, which replaces `_harness_test_begin` in each link.
pub fn standalone_record_calls() -> HarnessCalls {
    {
        test_begin: "_harness_test_begin",
        test_check_failure: "tg_test_check_failure",
        nat_to_string: "_harness_nat_to_string",
        exit_fn: "tg_exit",
        record_begin: "_harness_record_begin",
        record_end: "tg_test_record_end"
    } : HarnessCalls
}

/// The whole standalone preamble: externs the program lacks, then the helpers.
pub fn standalone_prelude(format: TestFormat, reused: List<String>) -> String {
    "// --- Test harness (generated by albite test, standalone mode) ---\n" ++
    extern_block(standalone_extern_needs(format), reused) ++
    "\n" ++ standalone_helpers(format)
}

/// One `extern "C" fn` line per need the program does not already declare.
///
/// The declarations are spelled out here rather than derived from `ExternNeed`,
/// which carries an arity but no parameter types. Detection and emission
/// therefore agree on the NAMES by construction (one table) and on the arities
/// by inspection — so a signature edited here without updating
/// `standalone_extern_needs` is caught the moment a fixture declares that
/// extern itself.
fn extern_block(needs: List<ExternNeed>, reused: List<String>) -> String {
    match needs {
        Nil() => "",
        Cons(need, rest) =>
            extern_line_unless_reused(need.name, reused) ++ extern_block(rest, reused)
    }
}

fn extern_line_unless_reused(name: String, reused: List<String>) -> String {
    if list_has_name(reused, name) { "" } else { extern_decl(name) }
}

pub fn extern_decl(name: String) -> String {
    if string_eq(name, "tg_test_begin") {
        "extern \"C\" fn tg_test_begin(name: Nat, len: Nat) -> Unit\n"
    } else if string_eq(name, "tg_test_check_failure") {
        "extern \"C\" fn tg_test_check_failure() -> Nat\n"
    } else if string_eq(name, "tg_println") {
        "extern \"C\" fn tg_println(s: Nat, len: Nat) -> Unit\n"
    } else if string_eq(name, "tg_exit") {
        "extern \"C\" fn tg_exit(code: Nat) -> Unit\n"
    } else if string_eq(name, "tg_string_to_cstring") {
        "extern \"C\" fn tg_string_to_cstring(s: String) -> Nat\n"
    } else if string_eq(name, "tg_free_string") {
        "extern \"C\" fn tg_free_string(s: Nat) -> Unit\n"
    } else if string_eq(name, "tg_string_len_internal") {
        "extern \"C\" fn tg_string_len_internal(s: String) -> Nat\n"
    } else {
        record_extern_decl(name)
    }
}

/// The record bracket's two declarations (ADR 1.10.26i D7). A tail of its own
/// so `extern_decl`'s chain stays under the cyclomatic gate.
fn record_extern_decl(name: String) -> String {
    if string_eq(name, "tg_test_record_begin") {
        "extern \"C\" fn tg_test_record_begin(name: Nat, len: Nat) -> Unit\n"
    } else if string_eq(name, "tg_test_record_end") {
        "extern \"C\" fn tg_test_record_end() -> Unit\n"
    } else {
        ""
    }
}

/// `_harness_println`, `_harness_test_begin`, and a digit renderer.
///
/// `_harness_nat_to_string` is a DIGIT table under a division loop, not the
/// ten-arm NUMBER table it replaces — so it renders 10 as `"10"` where the old
/// one rendered `"many"` (§1.3). It builds the string with `++`, a native term,
/// which is why it needs no `tg_string_append_char`: two fewer externs to
/// collide with, and the whole helper stays evaluable.
fn standalone_helpers(format: TestFormat) -> String {
    "fn _harness_println(s: String) -> Unit {\n" ++
    "    let c = tg_string_to_cstring(s);\n" ++
    "    let len = tg_string_len_internal(s);\n" ++
    "    tg_println(c, len);\n" ++
    "    tg_free_string(c)\n" ++
    "}\n\n" ++
    "fn _harness_test_begin(name: String) -> Unit {\n" ++
    "    let c = tg_string_to_cstring(name);\n" ++
    "    let len = tg_string_len_internal(name);\n" ++
    "    tg_test_begin(c, len);\n" ++
    "    tg_free_string(c)\n" ++
    "}\n\n" ++
    record_begin_helper(format) ++
    "fn _harness_digit(d: Nat) -> String {\n" ++
    "    if d == 0 { \"0\" } else if d == 1 { \"1\" } else if d == 2 { \"2\" }\n" ++
    "    else if d == 3 { \"3\" } else if d == 4 { \"4\" } else if d == 5 { \"5\" }\n" ++
    "    else if d == 6 { \"6\" } else if d == 7 { \"7\" } else if d == 8 { \"8\" }\n" ++
    "    else { \"9\" }\n" ++
    "}\n\n" ++
    "#[partial]\n" ++
    "fn _harness_digits(n: Nat, acc: String) -> String {\n" ++
    "    let acc2 = _harness_digit(n % 10) ++ acc;\n" ++
    "    let rest = n / 10;\n" ++
    "    if rest == 0 { acc2 } else { _harness_digits(rest, acc2) }\n" ++
    "}\n\n" ++
    "fn _harness_nat_to_string(n: Nat) -> String {\n" ++
    "    _harness_digits(n, \"\")\n" ++
    "}\n"
}

/// `_harness_record_begin`, shaped like `_harness_test_begin` — in a machine
/// format only, so the human prelude is byte-for-byte unchanged.
fn record_begin_helper(format: TestFormat) -> String {
    if test_format_is_machine(format) {
        "fn _harness_record_begin(name: String) -> Unit {\n" ++
        "    let c = tg_string_to_cstring(name);\n" ++
        "    let len = tg_string_len_internal(name);\n" ++
        "    tg_test_record_begin(c, len);\n" ++
        "    tg_free_string(c)\n" ++
        "}\n\n"
    } else {
        ""
    }
}
