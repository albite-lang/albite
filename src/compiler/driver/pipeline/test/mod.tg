    eprintln, println, stderr_is_tty,
    List, Nil, Cons
};
use driver::util::{
    Result, Ok, Err, Option, Some, None,
    nat_to_string, not, list_len
};
use driver::cli::{TestOpts};
use driver::modules::{
    ParsedModule,
    build_module_info, tree_failure_message,
    parsed_module_parse_errors, parsed_module_lex_errors
};
use driver::packages::{
    ProjectTree, ProjectFailure, ProjectUnparsed, ProjectRefused, parse_project_tree,
    project_module_info, report_package_notes
};
use parser::error::{parse_has_errors, parse_error_count};
use lexer::error::{has_errors, error_count};
use elab::env::types::{ElabTest};
use elab::items::{ElabResult, elab_result_ok, elab_result_error_count};
use elab::items::result::ElabDef;
use elab::items::per_module::{elaborate_module_tree};
use elab::error::{
    ElabError, errors_deduplicate,
    SourceInfo, source_info_new,
    render_diagnostics_limited
};
use elab::error::render::colors::{colorize_bold, ColorRed, ColorCyan};
use driver::pipeline::test::exit::{
    TestRunResult, TestsPassed, TestsFailed, TestRunnerFailed
};
use driver::pipeline::errors::{render_module_tree_errors, sources_for_errors};
use driver::cli::format::{error_format_for_test, error_format_is_json, test_format_is_machine};
use driver::pipeline::test::records::{
    report_runner_stop, report_empty_run, report_diagnostics_stop, print_elab_error_json_lines
};
use driver::pipeline::test::execute::{compile_and_run_tests};
use driver::pipeline::test::mode::{plan_harness, unsupported_reason};
use driver::pipeline::test::mode::types::{HarnessPlan};
use driver::pipeline::test::discovery::{
    TestDiscovery, TestSkip,
    EmptySuiteAction, FailRequireTests, ReportNoTests, Proceed,
    find_test_defs, classify_empty_suite
};

// ===========================================================================
// TEST PIPELINE
// ===========================================================================

/// Run the test pipeline: discover tests, generate harness, compile and run.
///
/// Every return is a `TestRunResult` (ADR 29.9.26i §2.1): diagnostics are
/// `TestsFailed` (1), and anything that stops the runner producing verdicts —
/// here, a module tree that does not resolve — is `TestRunnerFailed` (2).
pub fn run_test(opts: TestOpts) -> TestRunResult {
    let use_color = stderr_is_tty();
    let max_errors = opts.max_errors;

    // Parse, and mount the manifest's packages (ADR 6.10.26j).
    match parse_project_tree(opts.file) {
        Err(failure) => test_project_failure(failure, opts, use_color, max_errors),
        Ok(project) => {
            report_package_notes(project.notes, error_format_for_test(opts.format));
            test_parsed_module(project, opts, use_color, max_errors)
        }
    }
}

/// A tree that did not parse keeps `test`'s own exit 2 (ADR 1.10.26h D9); the
/// package planner's refusals are diagnostics, exit 1.
fn test_project_failure(failure: ProjectFailure, opts: TestOpts,
                        use_color: Bool, max_errors: Nat) -> TestRunResult {
    match failure {
        ProjectUnparsed(tree_failure) => {
            report_runner_stop(opts.format, Nil, tree_failure_message(tree_failure), opts.file, use_color);
            TestRunnerFailed
        },
        ProjectRefused(errors) => {
            report_test_errors(errors, opts, use_color, max_errors);
            TestsFailed(list_len(errors))
        }
    }
}

/// Check for lex/parse errors, then elaborate and discover tests.
fn test_parsed_module(project: ProjectTree, opts: TestOpts,
                      use_color: Bool, max_errors: Nat) -> TestRunResult {
    // Whole-tree walk (ADR 12.8.26b P1/AC6) — see `render_module_tree_errors`.
    let total_errs = render_module_tree_errors(project.tree, error_format_for_test(opts.format),
                                               max_errors, use_color);

    if total_errs > 0 {
        report_diagnostics_stop(opts.format, opts.file);
        TestsFailed(total_errs)
    } else {
        elaborate_and_test(project, opts, use_color, max_errors)
    }
}

/// Errors as JSON lines or human diagnostics, then the stop record.
fn report_test_errors(errors: List<ElabError>, opts: TestOpts, use_color: Bool, max_errors: Nat) -> Unit {
    // Each error against its own file's source (ADR 30.9.26h D2).
    let deduped = errors_deduplicate(errors);
    let sources = sources_for_errors(deduped);
    if error_format_is_json(error_format_for_test(opts.format)) {
        print_elab_error_json_lines(deduped, sources)
    } else {
        eprintln(render_diagnostics_limited(deduped, sources, max_errors, use_color))
    };
    report_diagnostics_stop(opts.format, opts.file)
}

/// Elaborate and discover test functions.
fn elaborate_and_test(project: ProjectTree, opts: TestOpts,
                      use_color: Bool, max_errors: Nat) -> TestRunResult {
    // Main's own info plans the harness; elaboration also sees the workspace
    // siblings' names (ADR 1.10.26f D5, wired by 3.10.26l D4), found beside
    // the manifest when there is one (ADR 6.10.26j D4), with the package
    // table (ADR 6.10.26p D2).
    let module = project.tree;
    let module_info = build_module_info(module);
    // Per-module elaboration (W6.3a)
    let elab_result = elaborate_module_tree(module, project_module_info(project), ElabTest);

    if not(elab_result_ok(elab_result)) {
        report_test_errors(elab_result.errors, opts, use_color, max_errors);
        TestsFailed(elab_result_error_count(elab_result))
    } else {
        let found: TestDiscovery = find_test_defs(elab_result.defs, opts.filter);
        report_skips(found.skips, use_color);
        // The plan is built HERE and not at the top of this function: it reads
        // `elab_result.defs` for D5's visibility half, and those are only
        // meaningful once `elab_result_ok` holds.
        let plan = plan_harness(module, module_info, elab_result.defs,
                                extract_test_names(found.tests), opts.format);
        act_on_suite(opts, found, plan, use_color)
    }
}

/// Dispatch on the empty-suite classification, mirroring the bootstrap's
/// `cmd_test` (`test_runner/mod.rs:262-272`).
///
/// The one deliberate divergence is the `Proceed` arm at `test_count == 0`
/// (everything skipped, `--require-tests` off). The bootstrap is an evaluator,
/// so running an empty list costs nothing; the self-host would fall through to
/// `compile_and_run_tests`, which writes a harness and shells out to the
/// bootstrap compiler on a compiler-sized file — minutes of work to run zero
/// tests, plus a generated artifact left behind. So it short-circuits. The
/// observable behaviour (skip warnings, zero tests, exit 0) is identical; only
/// the wasted work is not.
fn act_on_suite(opts: TestOpts, found: TestDiscovery, plan: HarnessPlan,
                use_color: Bool) -> TestRunResult {
    let test_count = list_len(found.tests);
    let skip_count = list_len(found.skips);
    match classify_empty_suite(test_count, skip_count, opts.require_tests) {
        FailRequireTests() => {
            report_runner_stop(opts.format, Nil,
                               "zero runnable tests discovered (--require-tests); " ++
                               nat_to_string(skip_count) ++ " function(s) skipped",
                               opts.file, use_color);
            TestRunnerFailed
        },
        ReportNoTests() => {
            // stdout, and the bootstrap's exact string (`test_runner/mod.rs`);
            // a machine format's empty report instead (ADR 1.10.26i D6).
            if test_format_is_machine(opts.format) {
                report_empty_run(opts.format, opts.file)
            } else {
                println("no tests found")
            };
            TestsPassed(0)
        },
        Proceed() =>
            if test_count == 0 {
                report_empty_run(opts.format, opts.file);
                TestsPassed(0)
            } else {
                run_servable_suite(opts, plan, use_color)
            }
    }
}

/// Refuse an unservable layout with ONE error, or run the suite.
///
/// This is where the ADR's user-visible value lands: the status quo for a
/// `mod`-declaring file whose ffi surface has moved was 77 E0016s at the call
/// sites, none of which named the cause. Detection fails closed, so the
/// alternative to this message is a harness that will not elaborate.
fn run_servable_suite(opts: TestOpts, plan: HarnessPlan, use_color: Bool) -> TestRunResult {
    match unsupported_reason(plan.mode) {
        Some(reason) => {
            report_runner_stop(opts.format, Nil,
                               "cannot generate a test harness for " ++ opts.file ++ ": " ++ reason,
                               opts.file, use_color);
            TestRunnerFailed
        },
        None() => compile_and_run_tests(opts, plan, use_color)
    }
}

// ===========================================================================
// TEST DISCOVERY
// ===========================================================================

/// Print one warning per rejected candidate, so the narrowing from candidates
/// to runnable tests is observable rather than silent.
///
/// Wording matches the bootstrap's `warning: skipping {name}: {reason}`
/// (`test_runner/mod.rs:346`); `colorize_bold` emits the bare word when stderr
/// is not a tty, which is the case any captured comparison sees.
fn report_skips(skips: List<TestSkip>, use_color: Bool) -> Unit {
    match skips {
        Nil() => (),
        Cons(skip, rest) => {
            eprintln(colorize_bold("warning", ColorCyan, use_color) ++
                    ": skipping " ++ skip.name ++ ": " ++ skip.reason);
            report_skips(rest, use_color)
        }
    }
}

/// Extract just the names from a list of ElabDefs.
fn extract_test_names(defs: List<ElabDef>) -> List<String> {
    match defs {
        Nil() => Nil,
        Cons(def, rest) => Cons(def.name, extract_test_names(rest))
    }
}
