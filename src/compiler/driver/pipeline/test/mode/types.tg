// src/compiler/driver/pipeline/test/mode/types.tg
// The harness-mode vocabulary, and the two tables that say what each mode
// needs from the program (ADR 7.8.26b D2/§2.2).
//
// Split from the decision (`decide.tg`) and the projections (`mod.tg`) so that
// both can import the vocabulary without importing each other.

use driver::ffi::{List, Nil, Cons};
use driver::util::{Option, list_append};
use lexer::span::{Span};
use driver::cli::format::{TestFormat, test_format_is_machine};

// ===========================================================================
// MODE
// ===========================================================================

/// Which template can serve a given test file.
///
/// `UnsupportedLayout` is built, not deferred: it is the difference between one
/// good error and the 77 bad ones that are the status quo.
pub type HarnessMode =
    | TreeMode
    | StandaloneMode
    | UnsupportedLayout(String)

/// Everything the generator needs that is not the user's source text.
///
/// `user_main` is the span of the root `main` **identifier**, if the file has
/// one — `None` for all 16 `src/compiler/test_*.tg`, none of which declares a
/// `main`. `reused_externs` names the externs the program already declares at
/// root with a matching arity, which standalone mode must therefore NOT
/// re-declare.
pub type HarnessPlan = {
    mode: HarnessMode,
    test_names: List<String>,
    test_count: Nat,
    reused_externs: List<String>,
    user_main: Option<Span>,
    format: TestFormat
}

// ===========================================================================
// WHAT DETECTION LOOKS AT
// ===========================================================================

/// Item name → the module path it is bound in, rendered.
pub type ItemPath = (String, String)

/// Item name → whether it is `pub`.
pub type ItemPublic = (String, Bool)

/// One extern the standalone preamble would declare, and its parameter count.
///
/// Arity is carried because name-only matching would silently reuse a
/// mismatched declaration and produce a type error behind the very wall this
/// ADR removes — `tg_test_begin` takes two parameters, so the case is reachable.
pub type ExternNeed = { name: String, arity: Nat }

/// One compiler symbol tree mode calls by qualified path.
pub type TreeSymbol = { name: String, module_path: String }

/// Whether the standalone externs can be reconciled with the program's own.
pub type ExternVerdict =
    | ExternsReconciled(List<String>)   // names to REUSE, i.e. not re-declare
    | ExternsConflict(String)

// ===========================================================================
// THE TWO TABLES
// ===========================================================================

/// The externs the standalone preamble declares, with their arities.
///
/// Seven, not the eleven the old preamble emitted: the three `tg_assert_eq_*`
/// went with the assertion surface (D4 — `assert_eq_*` is the user's business,
/// and a test runner has no reason to define it), and `tg_print` was declared
/// but never called. Every name dropped is a collision that can no longer
/// happen, which is the invariant paying out rather than a tidy-up.
///
/// A machine format adds the record bracket's two (ADR 1.10.26i D7); the human
/// list is byte-for-byte what it was, so human detection cannot move.
pub fn standalone_extern_needs(format: TestFormat) -> List<ExternNeed> {
    if test_format_is_machine(format) {
        list_append(human_extern_needs(),
            Cons({ name: "tg_test_record_begin", arity: 2 } : ExternNeed,
            Cons({ name: "tg_test_record_end", arity: 0 } : ExternNeed, Nil)))
    } else {
        human_extern_needs()
    }
}

fn human_extern_needs() -> List<ExternNeed> {
    Cons({ name: "tg_test_begin", arity: 2 } : ExternNeed,
    Cons({ name: "tg_test_check_failure", arity: 0 } : ExternNeed,
    Cons({ name: "tg_println", arity: 2 } : ExternNeed,
    Cons({ name: "tg_exit", arity: 1 } : ExternNeed,
    Cons({ name: "tg_string_to_cstring", arity: 1 } : ExternNeed,
    Cons({ name: "tg_free_string", arity: 1 } : ExternNeed,
    Cons({ name: "tg_string_len_internal", arity: 1 } : ExternNeed,
    Nil)))))))
}

/// The five compiler symbols tree mode calls, and where each is DEFINED.
///
/// Defining paths, not re-export paths: `nat_to_string` is also reachable as
/// `driver::util::nat_to_string` through two globs, but a re-export can cap
/// visibility and the canonical path cannot. The list is exactly what
/// `tree.tg`'s template emits — if one moves, both move.
///
/// A machine format adds the two record calls (ADR 1.10.26i D7), so a tree
/// that lacks them is refused with the one-line error, not a link failure.
pub fn tree_mode_symbols(format: TestFormat) -> List<TreeSymbol> {
    if test_format_is_machine(format) {
        list_append(human_tree_symbols(),
            Cons({ name: "record_test_begin", module_path: "driver::ffi::test" } : TreeSymbol,
            Cons({ name: "record_test_end", module_path: "driver::ffi::test" } : TreeSymbol, Nil)))
    } else {
        human_tree_symbols()
    }
}

fn human_tree_symbols() -> List<TreeSymbol> {
    Cons({ name: "test_begin", module_path: "driver::ffi::test" } : TreeSymbol,
    Cons({ name: "test_check_failure", module_path: "driver::ffi::test" } : TreeSymbol,
    Cons({ name: "println", module_path: "driver::ffi::process" } : TreeSymbol,
    Cons({ name: "process_exit", module_path: "driver::ffi::process" } : TreeSymbol,
    Cons({ name: "nat_to_string", module_path: "driver::util::strings::convert" } : TreeSymbol,
    Nil)))))
}
