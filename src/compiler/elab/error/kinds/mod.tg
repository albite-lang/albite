// src/compiler/elab/error/kinds/mod.tg
// Error kinds for the elaborator: the enum itself.
//
// Split from its two projections (ADR 19.8.26d): `codes.tg` maps a kind to its
// `E….` code and `messages.tg` maps it to its wording. Both are total matches
// over this enum, so adding a variant here is a compile error there until both
// projections say what it becomes — which is the property the split is for.
//
// **Bootstrap/self-host error code numbering differs.** The self-hosted compiler uses range-based
// numbering (E0001-E0099 for types, E0100-E0199 for names, etc.).
// The bootstrap (`bootstrap/src/elaborate/error/kind.rs`) uses a flat scheme.
//
// Key divergences:
//   self-host ErrTypeMismatch   = E0001   vs  bootstrap TypeMismatch       = E0010
//   self-host ErrUnresolvedValue = E0101  vs  bootstrap UndefinedVariable  = E0001
//   self-host ErrUnresolvedType  = E0100  vs  bootstrap UndefinedType      = E0002
//
// .tg test assertions (expect_error, expect_type) use bootstrap codes since the bootstrap runs them.

pub mod codes;
pub mod messages;

pub use elab::error::kinds::codes::*;
pub use elab::error::kinds::messages::*;

use lexer::span::Span;
use elab::ffi::{TypeHandle};
use driver::ffi::{List, Nil, Cons};

// ===========================================================================
// ERROR KINDS
// ===========================================================================

/// Error kinds for elaboration.
/// Each variant carries relevant contextual data.
///
/// Error code ranges:
/// - E0001-E0099: Type errors
/// - E0100-E0199: Name resolution errors
/// - E0200-E0299: Item/definition errors
/// - E0300-E0399: Pattern matching errors
/// - E0400-E0499: Proof errors
/// - E0500-E0599: Reference/mutability errors
/// - E0600-E0699: Entry point errors
/// - E0700-E0799: Soundness gates (E0700-E0709 positivity; E0710+ reserved
///                for the termination mirror, ADR 18.8.26b D4)
/// - E0800-E0899: Syntax — parse and lex errors, NOT this enum: they are
///                `parser::syntax_kind::SyntaxKind`, at a fixed offset from
///                the bootstrap's E0110-E0117 (ADR 30.9.26h D4)
/// - E0900-E0999: Other/internal errors
pub type ElabErrorKind =
    // Type errors (E0001-E0099)
    | ErrTypeMismatch(TypeHandle, TypeHandle)       // (expected, actual)
    | ErrArityMismatch(Nat, Nat)                    // (expected, actual)
    | ErrNotAFunction(TypeHandle)                   // Type that was expected to be function
    | ErrNotAType(String)                           // Name that was expected to be a type
    | ErrNotAnAdt(TypeHandle)                       // Type that was expected to be ADT
    | ErrNotASum(TypeHandle)                        // Type that was expected to be sum
    | ErrNotAPair(TypeHandle)                       // Type that was expected to be pair
    | ErrCannotInfer(String)                        // What couldn't be inferred
    | ErrIntLiteralOutOfRange(String)               // Literal outside the signed 64-bit range (ADR 14.9.26c)

    // Name resolution errors (E0100-E0199)
    | ErrUnresolvedType(String)                     // Type name not found
    | ErrUnresolvedValue(String)                    // Value name not found
    | ErrUnresolvedModule(String)                   // Module not found
    | ErrDuplicateDef(String)                       // Name already defined
    | ErrDuplicateImport(String, Span, Span, String, String)  // (name, first_span, second_span, first_module, second_module)
    | ErrPrivateAccess(String, String, String)      // (item_name, defined_in, accessed_from)
    | ErrAmbiguousName(String, List<String>)        // Name with multiple candidates
    | ErrBuiltinTypeRedefined(String)               // `type` under a builtin type's name (ADR 14.9.26c)
    | ErrGlobConflict(String, String, String)       // (name, first_module, second_module): two globs, two defs (ADR 4.10.26l D4)
    // Package errors, E0120-E0124, numbered as the bootstrap's (ADR 6.10.26j
    // D4). Each carries the message the shared planner rendered, so both
    // compilers print the same words.
    | ErrManifestInvalid(String)                    // albite.toml off the schema
    | ErrDependencyNotFound(String)                 // a dependency's directory, manifest or lib.tg missing
    | ErrPackageNameConflict(String)                // a key that clashes with a name
    | ErrPackageExternCollision(String)             // two packages declare one C symbol (raised by ADR 6.10.26p)
    | ErrDependencyCycle(String)                    // the dependency graph loops

    // Item/definition errors (E0200-E0299)
    | ErrMissingReturnType(String)                  // Function missing return type annotation
    | ErrInvalidExtern(String)                      // Extern function error
    | ErrImportNotFound(String)                     // Import path not found
    | ErrGlobImportEmpty(String)                    // Glob import found nothing
    | ErrCyclicDependency(List<String>)             // Cycle in type definitions
    | ErrInvalidVisibility(String)                  // pub on invalid item
    | ErrMissingBody(String)                        // Function/theorem without body
    
    // Pattern matching errors (E0300-E0399)
    | ErrInexhaustiveMatch(List<String>)            // Missing patterns
    | ErrUnreachablePattern                         // Pattern can never match
    | ErrConstructorNotFound(String, String)        // (constructor, type)
    | ErrDuplicateField(String)                     // Field name repeated
    | ErrMissingField(String)                       // Required field missing
    | ErrExtraField(String)                         // Unexpected field
    | ErrMultiArmMatch(Nat)                         // Match with too many arms (>2)
    | ErrPatternTooDeep(Nat)                         // Pattern nesting exceeds limit
    | ErrUnsupportedPattern(String)                 // Pattern the match cannot take (ADR 18.9.26e)
    
    // Proof errors (E0400-E0499)
    | ErrProofRequired(String)                      // Expected proof term
    | ErrSorryInProd                                // sorry used in production
    | ErrInvalidRefl(TypeHandle, TypeHandle)        // refl on non-equal types
    | ErrSubstExpectedEquality(TypeHandle)           // subst arg not Eq type
    | ErrTransEndpointMismatch(TypeHandle, TypeHandle) // trans h1.rhs != h2.lhs
    | ErrCongExpectedFunction(TypeHandle)            // cong first arg not function
    | ErrMotiveNotPredicate(TypeHandle)               // subst motive not a predicate lambda
    | ErrMotiveDomainMismatch(TypeHandle, TypeHandle)  // motive param type ≠ equality base type
    | ErrMotiveBodyNotType                            // motive body is a term, not a type
    
    // Reference/mutability errors (E0500-E0599)
    | ErrRefInPureContext                           // ref in pure code
    | ErrCannotMutate(String)                       // Trying to mutate immutable
    
    // Expression errors (E0600-E0699)
    | ErrNoReturnContext                            // return outside function
    | ErrNoMainFunction                             // No main function found
    | ErrInvalidMainSig(TypeHandle)                 // main has wrong signature
    
    // Soundness gates (E0700-E0799): positivity holds E0700-E0709, termination
    // E0710-E0719. Both messages are rendered by the shared engine, so the two
    // compilers cannot word one violation differently.
    | ErrNonStrictlyPositive(String)
    | ErrCannotProveTermination(String)
    | ErrPartialInProof(String)
    // Affine handles, E0720-E0729 (ADR 7.10.26t): (handle, definition).
    | ErrHandleUsedAfterConsumed(String, String)
    | ErrHandleCapturedByClosure(String, String)
    // Regions, E0730-E0739 (ADR 9.10.26o): the offending type; (name, reason).
    | ErrRegionNotFirstOrder(String)
    | ErrRegionReachesOutside(String, String)
    | ErrRegionInProof
    
    // Other errors (E0900-E0999)
    | ErrRecursionLimitExceeded(Nat)                // Hit recursion limit
    | ErrPhase1Violation(String)                    // Violation of phase 1 rules
    | ErrNotImplemented(String)                     // Feature not yet implemented
    // (code, message): a catalogued code an expression or type error already
    // carried, kept across the item boundary rather than dropped (ADR 2.10.26i D2)
    | ErrCoded(String, String)
    | ErrOther(String)                              // Internal faults only
