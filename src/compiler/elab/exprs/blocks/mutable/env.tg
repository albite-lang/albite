// src/compiler/elab/exprs/blocks/mutable/env.tg
// What the self-host's environment knows about `let mut` (ADR 13.10.26r D5).
//
// The Env record is not widened (the self-host has no record update, and
// every `env_with_*` helper would gain a field). The three facts ride as
// MARKER locals instead, each named with a `#` no source can spell, so no
// source name collides with one and Core never mentions one (Core variables
// are named, and a marker is never read as a term):
//
//   `x#mut`     bound just before a `mut` `x`: `x` is `mut` exactly when the
//               marker sits one binding older than the innermost `x`
//   `#closure`  bound on entering a lambda: a local older than it is outside
//   `#region`   bound on entering a region: likewise

use lexer::span::Span;
use driver::ffi::{List, Nil, Cons};
use elab::ffi::{TypeHandle, tg_type_unit};
use elab::env::{Env, env_push_scope, env_bind_local, env_lookup_local, env_resolve_value,
    MaybeResolvedValue, NoResolvedValue, SomeResolvedValue,
    ResolvedValue, ResolvedLocal, ResolvedGlobal, ResolvedConstructor};
use elab::exprs::forms::result::{
    ElabExprResult, ElabExprOk, ElabExprErr, ElabExprError, elab_expr_error_coded
};

/// What the scope outside a lowered block knows about one name.
pub type OuterFacts =
    | OuterUnknown
    | OuterImmutable
    | OuterMutable(Bool, Bool)   // (outside the current closure, outside the current region)

/// The scope a lowering starts from: the environment, or none (the handle
/// walk's, which leaves every outer assignment for the elaborator).
pub type MutScope =
    | ScopeFromEnv(Env)
    | ScopeEmpty

/// The de Bruijn index of a local, with whether it is bound at all.
fn local_index(env: Env, name: String) -> (Bool, Nat) {
    match env_lookup_local(env, name) {
        NoResolvedValue() => (false, 0),
        SomeResolvedValue(resolved) => resolved_index(resolved)
    }
}

fn resolved_index(resolved: ResolvedValue) -> (Bool, Nat) {
    match resolved {
        ResolvedLocal(index, _, _) => (true, index),
        _ => (false, 0)
    }
}

fn is_local(resolved: ResolvedValue) -> Bool {
    match resolved {
        ResolvedLocal(_, _, _) => true,
        _ => false
    }
}

/// Whether the innermost `name` was bound by `let mut` (or an assignment).
pub fn env_local_is_mut(env: Env, name: String) -> Bool {
    let (found, index) = local_index(env, name);
    let (marked, marker) = local_index(env, name ++ "#mut");
    found && marked && marker == index + 1
}

/// Whether the local `name` was bound before the innermost `marker`.
fn bound_outside(env: Env, name: String, marker: String) -> Bool {
    let (found, index) = local_index(env, name);
    let (entered, floor) = local_index(env, marker);
    found && entered && index > floor
}

/// Bind `name` as a `mut` local of type `ty`.
pub fn env_bind_mutable(env: Env, name: String, ty: TypeHandle) -> Env {
    env_bind_local(env_bind_local(env, name ++ "#mut", tg_type_unit()), name, ty)
}

/// The environment one lambda deeper.
pub fn env_enter_closure(env: Env) -> Env {
    env_bind_local(env_push_scope(env), "#closure", tg_type_unit())
}

/// The environment one region deeper.
pub fn env_enter_region(env: Env) -> Env {
    env_bind_local(env_push_scope(env), "#region", tg_type_unit())
}

/// Elaborate under a marker, handing back the caller's environment.
pub fn restore_env(env: Env, result: ElabExprResult) -> ElabExprResult {
    match result {
        ElabExprErr(e) => ElabExprErr(e),
        ElabExprOk(_, term, ty, cir) => ElabExprOk(env, term, ty, cir)
    }
}

/// What the scope knows about `name`.
pub fn outer_facts(scope: MutScope, name: String) -> OuterFacts {
    match scope {
        ScopeEmpty() => OuterUnknown,
        ScopeFromEnv(env) => env_facts(env, name, env_resolve_value(env, name))
    }
}

fn env_facts(env: Env, name: String, resolved: MaybeResolvedValue) -> OuterFacts {
    match resolved {
        NoResolvedValue() => OuterUnknown,
        SomeResolvedValue(value) => local_facts(env, name, is_local(value))
    }
}

fn local_facts(env: Env, name: String, local: Bool) -> OuterFacts {
    if local && env_local_is_mut(env, name) {
        OuterMutable(bound_outside(env, name, "#closure"), bound_outside(env, name, "#region"))
    } else {
        OuterImmutable
    }
}

/// E0741 when `name` is a `mut` local declared outside the lambda being
/// elaborated (M3: any mention, not only an escaping one).
pub fn captured_mutable(env: Env, name: String) -> Bool {
    env_local_is_mut(env, name) && bound_outside(env, name, "#closure")
}

// ---------------------------------------------------------------------------
// The three refusals, word for word the bootstrap's (E0104–E0106)
// ---------------------------------------------------------------------------

pub fn not_mut_error(name: String, span: Span) -> ElabExprError {
    elab_expr_error_coded("cannot assign to `" ++ name ++ "`: it is not declared `let mut`", span, "E0740")
}

pub fn not_joined_error(name: String, span: Span) -> ElabExprError {
    elab_expr_error_coded("cannot assign to `" ++ name ++ "` here: only an `if`, `match` or block statement hands an assignment back to later code", span, "E0740")
}

pub fn exit_not_joined_error(name: String, exit: String, span: Span) -> ElabExprError {
    elab_expr_error_coded("cannot assign to `" ++ name ++ "` in a branch that can leave through `" ++ exit ++ "`: a branch that hands an assignment back cannot exit early", span, "E0740")
}

pub fn captured_error(name: String, span: Span) -> ElabExprError {
    elab_expr_error_coded("a closure cannot mention `" ++ name ++ "`, a `let mut` binding declared outside it", span, "E0741")
}

pub fn in_region_error(name: String, span: Span) -> ElabExprError {
    elab_expr_error_coded("cannot assign to `" ++ name ++ "` inside a region: it is declared outside the region", span, "E0742")
}

/// The refusal for an assignment to a binding declared outside the lowered
/// block: a closure's, a region's, or not joined.
pub fn outer_refusal(facts: OuterFacts, name: String, span: Span) -> ElabExprError {
    match facts {
        OuterMutable(outside_closure, outside_region) =>
            if outside_closure { captured_error(name, span) }
            else if outside_region { in_region_error(name, span) }
            else { not_joined_error(name, span) },
        _ => not_mut_error(name, span)
    }
}
