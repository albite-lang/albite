// src/compiler/elab/ffi/termination.tg
// Bindings for the termination mirror (ADR 19.8.26d §2.2).
//
// The soundness RULE is not reimplemented here. Both compilers call one
// `termination::analyze_with_carried` in `albite_core` — the *carried* form,
// never the `analyze` wrapper, which drops the channel this seam is built on.
// What crosses is the definition environment the rule runs over.
//
// ## The protocol, as a grammar
//
//   reset ( note_item note_param_type* )* ( declare )* ( add_def )* plan
//     ( add_def )* check
//
// with `note_type note_type_ref*` allowed anywhere after `reset`.
//
// The definition stream is walked TWICE, and that is the design rather than an
// accident. `DefView` borrows a whole `Term`, so marshalling every definition
// at once and holding it live measured +587 MiB on `src/compiler/main.tg`
// (ADR 19.8.26d P0) — of which 91.6% was terms, held for an analysis that
// needs a real term only inside a recursive component. So the first pass
// reduces each definition to the name sets the occurrence graph and taint need
// and DROPS it, `plan` finds the recursive components, and the second pass
// retains only those.
//
// `declare` must come before any `add_def`: mention sets are filtered against
// the declared names, so a definition reduced before its callees were declared
// would record no edge to them.
//
// Every departure from the grammar RETURNS FALSE and records a message for
// `tg_get_last_error` — none is silently ignored, because a dropped definition
// is a program that passes the termination gate only because the offending
// recursion never arrived.

use elab::ffi::{TermHandle, TypeHandle};

// ===========================================================================
// REGISTRATION (eight externs)
// ===========================================================================

// Start a fresh environment, discarding the previous program's definitions,
// its plan and its rejections.
pub extern "C" fn tg_termination_reset() -> Unit

// Note one item's attributes and role. `name` and `decreasing` are C-string
// pointers; `decreasing` is 0 (a NULL pointer) when the item carries no
// `#[decreasing(arg)]`. Unlike an arena handle, address 0 is never a valid
// string, so NULL is the honest spelling of "absent" here.
pub extern "C" fn tg_termination_note_item(
    name: Nat, partial: Bool, decreasing: Nat, proof: Bool
) -> Bool

// Note one type declaration — its kind, in the positivity seam's codes
// (`POSITIVITY_KIND_*`), and its constructor count — then every type name its
// declared body spells (ADR 3.9.26f). The graph is the DECLARED one on
// purpose: an elaborated field type has already inlined a structural encoding
// and lost the name, which makes a cluster edge depend on declaration order.
// Type notes sit outside the definition stream's grammar and are allowed in
// any phase; a re-note replaces the previous reading of that type.
pub extern "C" fn tg_termination_note_type(name: Nat, kind: Nat, constructors: Nat) -> Bool
pub extern "C" fn tg_termination_note_type_ref(name: Nat, referenced: Nat) -> Bool

// Record the type name one parameter's annotation spelled; `position` counts
// value parameters from 0 (ADR 3.9.26f).
//
// This encoder μ-wraps a type only when a field names it DIRECTLY, so a
// cluster member reached through another type (`MaybeExpr` -> `Expr` ->
// `MaybeExpr`) or through a generic argument (`List<UseTree>`) arrives at the
// engine as a bare structural sum, which descent refuses as a root. The name
// travelling beside the structure is what lets the engine see the root the
// bootstrap's μ-encoding shows it.
pub extern "C" fn tg_termination_note_param_type(
    name: Nat, position: Nat, type_name: Nat
) -> Bool

// Declare one definition name, fixing the node set.
pub extern "C" fn tg_termination_declare(name: Nat) -> Bool

// Offer one definition's payload: reduced and dropped before `plan`, retained
// if the plan wants it after.
pub extern "C" fn tg_termination_add_def(
    name: Nat, ty: TypeHandle, term: TermHandle
) -> Bool

// Close the reduction stream; returns how many definitions the plan retains,
// which is 0 when `with_descent` is false and only the taint half is wanted.
pub extern "C" fn tg_termination_plan(with_descent: Bool) -> Nat

// ===========================================================================
// READERS (three)
// ===========================================================================

// Run the analysis; returns the rejection count.
pub extern "C" fn tg_termination_check() -> Nat

// How many rejections the last check found.
pub extern "C" fn tg_termination_failure_count() -> Nat

// The i-th rejection, as a C string holding "<kind>\n<function>\n<message>".
//
// Indexed rather than handle-returning because one program can fail in several
// places: a single-handle return would render the first and drop the rest.
pub extern "C" fn tg_termination_failure_render(index: Nat) -> Nat

// ===========================================================================
// δ DEFERRAL AND DISCHARGE (ADR 7.10.26u)
// ===========================================================================
//
// A `refl` that fails δ-free is deferred if a global could change it, and
// discharged once admission has run, unfolding only `Total` definitions — the
// bootstrap's rule (ADR 28.9.26d). `reset` opens a program's deferral and the
// discharge closes it, so an entry point that never discharges refuses.

// Defer `lhs == rhs` from a `refl` at bytes `start..end` of `file` (a C
// string). True when recorded; false when the failure is final.
pub extern "C" fn tg_conversion_defer(
    lhs: TermHandle, rhs: TermHandle, start: Nat, end: Nat, file: Nat
) -> Bool

// Turn deferral on or off; returns the previous setting, for restoring.
pub extern "C" fn tg_conversion_deferral_set(enabled: Bool) -> Bool

// Discharge every recorded obligation; returns how many failed. Call after
// `tg_termination_check`.
pub extern "C" fn tg_conversion_discharge() -> Nat

// The i-th failure, as a C string "<start>\n<end>\n<file>\n<note>"; the note
// is empty when there is none.
pub extern "C" fn tg_conversion_failure_render(index: Nat) -> Nat

// ===========================================================================
// WIRE KINDS
// ===========================================================================

// The `<kind>` field of a rendered rejection. The split is the bootstrap's:
// "this recursion does not descend" and "this proof reaches a partial
// constant" are different repairs, so they are different diagnostics.
pub fn TERMINATION_KIND_NO_DESCENT() -> String { "0" }
pub fn TERMINATION_KIND_PARTIAL_IN_PROOF() -> String { "1" }
