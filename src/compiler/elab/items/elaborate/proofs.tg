// src/compiler/elab/items/elaborate/proofs.tg
// Theorem, axiom, and extern body elaboration.

use parser::ast::{
    TheoremDef, AxiomDef, ExternFnDef,
    Param, ExternParam, TypeParam,
    Ident, ident_name,
    MaybeString, NoString, SomeString
};
use driver::ffi::{List, Nil, Cons};
use elab::ffi::{
    TermHandle, TypeHandle,
    tg_term_sorry, tg_term_abs, tg_term_var_named,
    tg_term_extern_call, tg_term_extern_call_arg,
    tg_type_get_arrow_codomain, tg_string_to_cstr
};
use elab::env::{
    Env, env_push_scope, env_pop_scope,
    env_lookup_value_def,
    ValueDefInfo, MaybeValueDef, SomeValueDef, NoValueDef
};
use elab::exprs::{check, ElabExprResult, ElabExprOk, ElabExprErr};
use elab::items::result::{
    ElabContext, elab_context_with_env, elab_context_add_error,
    ElabItemResult, ElabItemOk, ElabItemErr,
    ElabDef, elab_def_new_with_cir,
    elab_context_add_expr_error
};
use elab::error::{elab_error_internal};
use elab::cir::{CIRSorry, ct_unit};
use elab::items::elaborate::helpers::{
    push_type_params_elab, pop_type_params_elab,
    bind_params_and_get_return, get_arrow_domain,
    build_lambda, build_lambda_cir,
    wrap_type_abs, wrap_type_abs_cir
};

// ===========================================================================
// THEOREM/LEMMA BODY ELABORATION
// ===========================================================================

/// Elaborate a theorem or lemma body (proof).
pub fn elaborate_theorem_body(ctx: ElabContext, def: TheoremDef) -> ElabItemResult {
    let thm_name = ident_name(def.name);
    
    // Look up the theorem's registered type
    match env_lookup_value_def(ctx.env, thm_name) {
        NoValueDef() =>
            let err = elab_error_internal("internal: theorem not found in environment", def.span);
            ElabItemErr(elab_context_add_error(ctx, err)),
        SomeValueDef(info) =>
            elaborate_theorem_found(ctx, def, thm_name, info)
    }
}

fn elaborate_theorem_found(ctx: ElabContext, def: TheoremDef, thm_name: String, info: ValueDefInfo) -> ElabItemResult {
    // Push type parameters
    let ctx2 = push_type_params_elab(ctx, def.type_params);
    
    // Create scope for parameters
    let ctx3 = elab_context_with_env(ctx2, env_push_scope(ctx2.env));
    
    // Bind parameters
    let (ctx4, prop_type) = bind_params_and_get_return(ctx3, def.params, info.ty);
    
    // Elaborate the proof body, checking against proposition type
    match check(ctx4.env, def.body, prop_type) {
        ElabExprErr(err) =>
            let ctx5 = elab_context_add_expr_error(ctx4, err);
            let ctx6 = elab_context_with_env(ctx5, env_pop_scope(ctx5.env));
            let ctx7 = pop_type_params_elab(ctx6, def.type_params);
            ElabItemErr(ctx7),
        ElabExprOk(env2, proof_term, _, proof_cir) =>
            let ctx5 = elab_context_with_env(ctx4, env2);
            
            // Build lambda for parameters
            let lambda_term = build_lambda(def.params, proof_term, info.ty);
            let final_term = wrap_type_abs(lambda_term, def.type_params);
            
            // Build CIR
            let lambda_cir = build_lambda_cir(def.params, proof_cir, info.ty);
            let final_cir = wrap_type_abs_cir(lambda_cir, def.type_params);
            
            let ctx6 = elab_context_with_env(ctx5, env_pop_scope(ctx5.env));
            let ctx7 = pop_type_params_elab(ctx6, def.type_params);
            
            let elab_def = elab_def_new_with_cir(thm_name, final_term, info.ty, final_cir, def.vis);
            ElabItemOk(ctx7, elab_def)
    }
}

// ===========================================================================
// AXIOM BODY ELABORATION
// ===========================================================================

/// Elaborate an axiom (no proof body - uses sorry).
pub fn elaborate_axiom_body(ctx: ElabContext, def: AxiomDef) -> ElabItemResult {
    let axiom_name = ident_name(def.name);
    
    // Look up the axiom's registered type
    match env_lookup_value_def(ctx.env, axiom_name) {
        NoValueDef() =>
            let err = elab_error_internal("internal: axiom not found in environment", def.span);
            ElabItemErr(elab_context_add_error(ctx, err)),
        SomeValueDef(info) =>
            // Push type parameters
            let ctx2 = push_type_params_elab(ctx, def.type_params);
            
            // Create scope for parameters
            let ctx3 = elab_context_with_env(ctx2, env_push_scope(ctx2.env));
            
            // Bind parameters and get proposition type
            let (ctx4, prop_type) = bind_params_and_get_return(ctx3, def.params, info.ty);
            
            // Build sorry term as the proof
            let sorry_term = tg_term_sorry(prop_type);
            let sorry_cir = CIRSorry(ct_unit());
            
            // Build lambda for parameters
            let lambda_term = build_lambda(def.params, sorry_term, info.ty);
            let final_term = wrap_type_abs(lambda_term, def.type_params);
            
            // Build CIR lambda
            let lambda_cir = build_lambda_cir(def.params, sorry_cir, info.ty);
            let final_cir = wrap_type_abs_cir(lambda_cir, def.type_params);
            
            let ctx5 = elab_context_with_env(ctx4, env_pop_scope(ctx4.env));
            let ctx6 = pop_type_params_elab(ctx5, def.type_params);
            
            let elab_def = elab_def_new_with_cir(axiom_name, final_term, info.ty, final_cir, def.vis);
            ElabItemOk(ctx6, elab_def)
    }
}

// ===========================================================================
// EXTERN FUNCTION ELABORATION
// ===========================================================================

/// Elaborate an extern function (FFI wrapper).
pub fn elaborate_extern_body(ctx: ElabContext, def: ExternFnDef) -> ElabItemResult {
    let fn_name = ident_name(def.name);
    
    // Get the symbol name (defaults to function name)
    let symbol = match def.symbol {
        NoString() => fn_name,
        SomeString(s) => s
    };
    
    // Look up the extern's registered type
    match env_lookup_value_def(ctx.env, fn_name) {
        NoValueDef() =>
            let err = elab_error_internal("internal: extern not found in environment", def.span);
            ElabItemErr(elab_context_add_error(ctx, err)),
        SomeValueDef(info) =>
            let extern_term = build_extern_wrapper(def.params, symbol, info.ty);
            // Codegen emits the call from the declaration and never reads the
            // wrapper term, so the CIR stays a placeholder (ADR 3.10.26q D1).
            let extern_cir = CIRSorry(ct_unit());
            
            let elab_def = elab_def_new_with_cir(fn_name, extern_term, info.ty, extern_cir, def.vis);
            ElabItemOk(ctx, elab_def)
    }
}

/// Build an extern function wrapper: the bootstrap's
/// `λp₁:T₁. … λpₙ:Tₙ. extern_call "__c_<symbol>" [p₁, …, pₙ]` (ADR 3.10.26q D1).
///
/// The `__c_` prefix is load-bearing: the termination engine's foreign-call
/// predicate strips it, and its `pure` exemption looks the symbol up through it.
/// Each `Tᵢ` is the registered type's arrow domain, which signature collection
/// built from the same parameter `TypeExpr`s with `elab_type`.
fn build_extern_wrapper(params: List<ExternParam>, symbol: String, fn_type: TypeHandle) -> TermHandle {
    let empty_call = tg_term_extern_call(tg_string_to_cstr("__c_" ++ symbol));
    wrap_extern_params(params, append_extern_call_args(empty_call, params), fn_type)
}

/// Append each parameter, in source order, as a named variable argument.
fn append_extern_call_args(call: TermHandle, params: List<ExternParam>) -> TermHandle {
    match params {
        Nil() => call,
        Cons(param, rest) =>
            let arg = tg_term_var_named(tg_string_to_cstr(ident_name(param.name)));
            append_extern_call_args(tg_term_extern_call_arg(call, arg), rest)
    }
}

/// Bind each parameter with a lambda whose type is `fn_type`'s next domain.
fn wrap_extern_params(params: List<ExternParam>, body: TermHandle, fn_type: TypeHandle) -> TermHandle {
    match params {
        Nil() => body,
        Cons(param, rest) =>
            let inner = wrap_extern_params(rest, body, tg_type_get_arrow_codomain(fn_type));
            tg_term_abs(tg_string_to_cstr(ident_name(param.name)), get_arrow_domain(fn_type), inner)
    }
}
