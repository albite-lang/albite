// String, character, and comment literal scanning.

use driver::ffi::string_char_at_internal;
use lexer::span::span_new;
use lexer::token::{
    Token, TokenKind,
    TokStringLit, TokCharLit, TokLineComment, TokDocComment, TokBlockComment, TokError,
    token_new
};
use lexer::error::{
    err_unterminated_string, err_unterminated_char,
    err_unterminated_block_comment
};
use lexer::scanner::chars::{
    char_newline, char_double_quote, char_single_quote, char_backslash,
    char_x, char_u, char_lbrace, char_rbrace, char_slash, char_star, char_bang
};
use lexer::scanner::state::{
    LexerState, ScanResult,
    lex_pos, lex_source, lex_file, lex_at_end, lex_peek, lex_peek_next,
    lex_advance, lex_advance_n, lex_add_error, lex_slice, lex_span
};

// ---------------------------------------------------------------------------
// STRING SCANNING
// ---------------------------------------------------------------------------

pub fn scan_string(lex: LexerState) -> ScanResult {
    let start = lex_pos(lex);
    let lex2 = lex_advance(lex);
    scan_string_contents(lex2, start)
}

// Partial (ADR 11.8.26b): the recursive call rebuilds its argument rather
// than passing a strict subterm — a measure recursion, which Non-Goals defers to
// v2.1. Executable compiler code no proof reaches; E0063 guards that.
#[partial]
fn scan_string_contents(lex: LexerState, start: Nat) -> ScanResult {
    if lex_at_end(lex) || lex_peek(lex) == char_newline() {
        unterminated_string_token(lex, start)
    } else if lex_peek(lex) == char_double_quote() {
        let lex2 = lex_advance(lex);
        let span = lex_span(lex2, start);
        let text = lex_slice(lex, start + 1, lex_pos(lex) - start - 1);
        { token: token_new(TokStringLit(text), span), state: lex2 }
    } else if lex_peek(lex) == char_backslash() {
        let lex2 = lex_advance(lex);
        if lex_at_end(lex2) {
            scan_string_contents(lex2, start)
        } else {
            let next = lex_peek(lex2);
            if next == char_x() {
                scan_string_contents(lex_advance_n(lex2, 3), start)
            } else if next == char_u() {
                scan_string_escape_unicode(lex_advance(lex2), start)
            } else {
                scan_string_contents(lex_advance(lex2), start)
            }
        }
    } else {
        scan_string_contents(lex_advance(lex), start)
    }
}

/// An unterminated string literal: the error, and the literal up to `lex`,
/// which is end of input or a raw newline. The newline is NOT consumed, so the
/// next line lexes normally — the bootstrap stops there too (ADR 3.10.26j D4),
/// rather than swallowing the rest of the file and the block's closing `}`.
fn unterminated_string_token(lex: LexerState, start: Nat) -> ScanResult {
    let lex2 = lex_add_error(lex, err_unterminated_string(start, lex_file(lex)));
    let span = lex_span(lex2, start);
    let text = lex_slice(lex2, start + 1, lex_pos(lex2) - start - 1);
    { token: token_new(TokStringLit(text), span), state: lex2 }
}

fn scan_string_escape_unicode(lex: LexerState, start: Nat) -> ScanResult {
    if lex_at_end(lex) || lex_peek(lex) != char_lbrace() {
        scan_string_contents(lex, start)
    } else {
        scan_string_escape_unicode_body(lex_advance(lex), start)
    }
}

fn scan_string_escape_unicode_body(lex: LexerState, start: Nat) -> ScanResult {
    if lex_at_end(lex) {
        scan_string_contents(lex, start)
    } else if lex_peek(lex) == char_rbrace() {
        scan_string_contents(lex_advance(lex), start)
    } else if lex_peek(lex) == char_double_quote() {
        scan_string_contents(lex, start)
    } else {
        scan_string_escape_unicode_body(lex_advance(lex), start)
    }
}

// ---------------------------------------------------------------------------
// CHARACTER SCANNING
// ---------------------------------------------------------------------------

pub fn scan_char(lex: LexerState) -> ScanResult {
    let start = lex_pos(lex);
    let lex2 = lex_advance(lex);
    if lex_at_end(lex2) {
        let lex3 = lex_add_error(lex2, err_unterminated_char(start, lex_file(lex)));
        let span = lex_span(lex3, start);
        { token: token_new(TokCharLit(0), span), state: lex3 }
    } else {
        let ch = lex_peek(lex2);
        let lex3 = if ch == char_backslash() {
            let lex_esc = lex_advance(lex2);
            if lex_at_end(lex_esc) {
                lex_esc
            } else {
                let escape_char = lex_peek(lex_esc);
                if escape_char == char_x() {
                    lex_advance_n(lex_esc, 3)
                } else if escape_char == char_u() {
                    scan_char_escape_unicode(lex_advance(lex_esc))
                } else {
                    lex_advance(lex_esc)
                }
            }
        } else { 
            lex_advance(lex2) 
        };
        if lex_at_end(lex3) || lex_peek(lex3) != char_single_quote() {
            let lex4 = lex_add_error(lex3, err_unterminated_char(start, lex_file(lex)));
            let span = lex_span(lex4, start);
            { token: token_new(TokCharLit(ch), span), state: lex4 }
        } else {
            let lex4 = lex_advance(lex3);
            let span = lex_span(lex4, start);
            { token: token_new(TokCharLit(ch), span), state: lex4 }
        }
    }
}

fn scan_char_escape_unicode(lex: LexerState) -> LexerState {
    if lex_at_end(lex) || lex_peek(lex) != char_lbrace() {
        lex
    } else {
        scan_char_escape_unicode_body(lex_advance(lex))
    }
}

// Partial (ADR 11.8.26b): the recursive call rebuilds its argument rather
// than passing a strict subterm — a measure recursion, which Non-Goals defers to
// v2.1. Executable compiler code no proof reaches; E0063 guards that.
#[partial]
fn scan_char_escape_unicode_body(lex: LexerState) -> LexerState {
    if lex_at_end(lex) {
        lex
    } else if lex_peek(lex) == char_rbrace() {
        lex_advance(lex)
    } else if lex_peek(lex) == char_single_quote() {
        lex
    } else {
        scan_char_escape_unicode_body(lex_advance(lex))
    }
}

// ---------------------------------------------------------------------------
// COMMENT SCANNING
// ---------------------------------------------------------------------------

pub fn scan_line_comment(lex: LexerState) -> ScanResult {
    let start = lex_pos(lex);
    let lex2 = lex_advance_n(lex, 2);
    let lex3 = scan_to_newline(lex2);
    let text = lex_slice(lex3, start + 2, lex_pos(lex3) - start - 2);
    let span = lex_span(lex3, start);
    let kind = if lex_pos(lex3) > start + 2 {
        let first = string_char_at_internal(lex_source(lex), start + 2);
        if first == char_slash() || first == char_bang() { TokDocComment(text) }
        else { TokLineComment(text) }
    } else { TokLineComment(text) };
    { token: token_new(kind, span), state: lex3 }
}

// Partial (ADR 11.8.26b): the recursive call rebuilds its argument rather
// than passing a strict subterm — a measure recursion, which Non-Goals defers to
// v2.1. Executable compiler code no proof reaches; E0063 guards that.
#[partial]
fn scan_to_newline(lex: LexerState) -> LexerState {
    if lex_at_end(lex) { lex }
    else if lex_peek(lex) == char_newline() { lex }
    else { scan_to_newline(lex_advance(lex)) }
}

// Where a block comment's body stopped, and whether it consumed the closing
// `*/` — an unterminated comment stops at end of input instead.
type BlockCommentBody = { state: LexerState, closed: Bool }

fn block_comment_body_state(body: BlockCommentBody) -> LexerState {
    body.state
}

fn block_comment_body_closed(body: BlockCommentBody) -> Bool {
    body.closed
}

// The comment's text drops the closing `*/` only when there is one: an
// unterminated comment runs to end of input, so its slice never ends inside
// a multi-byte last character (ADR 16.10.26h D8).
pub fn scan_block_comment(lex: LexerState) -> ScanResult {
    let start = lex_pos(lex);
    let lex2 = lex_advance_n(lex, 2);
    let body = scan_block_comment_body(lex2, start, 1);
    let lex3 = block_comment_body_state(body);
    let closer = if block_comment_body_closed(body) { 2 } else { 0 };
    let text = lex_slice(lex3, start + 2, lex_pos(lex3) - start - 2 - closer);
    let span = lex_span(lex3, start);
    { token: token_new(TokBlockComment(text), span), state: lex3 }
}

// Partial (ADR 11.8.26b): the recursive call rebuilds its argument rather
// than passing a strict subterm — a measure recursion, which Non-Goals defers to
// v2.1. Executable compiler code no proof reaches; E0063 guards that.
#[partial]
fn scan_block_comment_body(lex: LexerState, start: Nat, depth: Nat) -> BlockCommentBody {
    if lex_at_end(lex) {
        let unterminated: BlockCommentBody = {
            state: lex_add_error(lex, err_unterminated_block_comment(start, lex_file(lex))),
            closed: false
        };
        unterminated
    } else if lex_peek(lex) == char_slash() && lex_peek_next(lex) == char_star() {
        scan_block_comment_body(lex_advance_n(lex, 2), start, depth + 1)
    } else if lex_peek(lex) == char_star() && lex_peek_next(lex) == char_slash() {
        if depth == 1 {
            let terminated: BlockCommentBody = { state: lex_advance_n(lex, 2), closed: true };
            terminated
        } else { scan_block_comment_body(lex_advance_n(lex, 2), start, depth - 1) }
    } else {
        scan_block_comment_body(lex_advance(lex), start, depth)
    }
}
