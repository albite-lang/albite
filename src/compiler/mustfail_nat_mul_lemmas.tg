// Negative control for test_nat_mul_lemmas.tg (ADR 1.10.26d AC 4).
//
// The positive suite pins the multiplication lemmas two ways: typed `let`
// citations that check only because each imported lemma is named,
// instantiated and converted, and `expect_error`s for the wrong citations and
// the non-definitional products. An expectation that silently stopped being
// compared would leave that suite green while asserting nothing. So this file
// is the same suite with EVERY expectation wrong — each accepted citation is
// restated at an instance it does not prove, each E0010 becomes E0071 and each
// E0071 becomes E0010 — and `check-mustfail-fixtures`
// (make/quality/tg-tests.mk) requires it to fail with exactly
//
//   albite test src/compiler/mustfail_nat_mul_lemmas.tg --require-tests
//     -> aborting due to 11 errors
//
// The count is the point: a case that stops being checked lowers it, and the
// gate goes red. A conversion that accepted everything would drop it too.
//
// The library is imported from `nat_arith.tg`: it is correct, so it raises
// nothing.
//
// Deliberately NOT named `test_*.tg`: `make tg-test` globs that pattern and a
// file that must fail would fail the gate by design.

// Cited by qualified path, as test_nat_mul_lemmas.tg does.
mod nat_arith;

// ── Each citation at an instance it does not prove ──────────────────────────

fn nat_mul_comm_at_a_literal(n: Nat) -> Unit {
    let _p: Eq<Nat, 2 * n, n * 3> = nat_arith::mul_comm(2, n);
    ()
}

fn nat_mul_comm_swapped(n: Nat, m: Nat) -> Unit {
    let _p: Eq<Nat, n * m, n * m> = nat_arith::mul_comm(m, n);
    ()
}

fn nat_mul_assoc_at_a_literal(n: Nat, m: Nat) -> Unit {
    let _p: Eq<Nat, (n * 2) * m, n * (3 * m)> = nat_arith::mul_assoc(n, 2, m);
    ()
}

fn nat_mul_add_at_one(n: Nat, m: Nat) -> Unit {
    let _p: Eq<Nat, n * (m + 1), n * m + n * 2> = nat_arith::mul_add(n, m, 1);
    ()
}

fn nat_add_mul_at_one(n: Nat, m: Nat) -> Unit {
    let _p: Eq<Nat, (n + 1) * m, n * m + 2 * m> = nat_arith::add_mul(n, 1, m);
    ()
}

fn nat_mul_succ_left_at_zero(n: Nat) -> Unit {
    let _p: Eq<Nat, (0 + 1) * n, (0 * n + n) + 1> = nat_arith::mul_succ_left(0, n);
    ()
}

fn nat_mul_comm_closed() -> Unit {
    let _p: Eq<Nat, 3 * 4, 4 * 4> = nat_arith::mul_comm(3, 4);
    ()
}

fn nat_mul_one_left(n: Nat) -> Eq<Nat, 2 * n, n> {
    trans(nat_arith::mul_comm(1, n), nat_arith::mul_one_right(n))
}

fn test_mul_comm_is_cited_at_a_literal() -> Unit {
    nat_mul_comm_at_a_literal(4)
}

fn test_mul_comm_is_cited_swapped() -> Unit {
    nat_mul_comm_swapped(4, 5)
}

fn test_mul_assoc_is_cited_at_a_literal() -> Unit {
    nat_mul_assoc_at_a_literal(4, 5)
}

fn test_mul_add_is_cited_at_one() -> Unit {
    nat_mul_add_at_one(4, 5)
}

fn test_add_mul_is_cited_at_one() -> Unit {
    nat_add_mul_at_one(4, 5)
}

fn test_mul_succ_left_is_cited_at_zero() -> Unit {
    nat_mul_succ_left_at_zero(4)
}

fn test_mul_comm_is_cited_closed() -> Unit {
    nat_mul_comm_closed()
}

fn test_one_times_n_is_proved_from_imported_lemmas() -> Unit {
    let _p: Eq<Nat, 2 * 4, 4> = nat_mul_one_left(4);
    ()
}

// ── The refusals, each expecting the other code ─────────────────────────────

fn test_mul_comm_at_the_wrong_instance_is_refused() -> Unit {
    expect_error(|n: Nat| { let _p: Eq<Nat, n * 2, 2 * n> = nat_arith::mul_comm(n, 3); 0 }, "E0071")
}

fn test_succ_times_m_is_not_refl() -> Unit {
    expect_error(|n: Nat, m: Nat| { let _p: Eq<Nat, (n + 1) * m, n * m + m> = refl; 0 }, "E0010")
}

fn test_n_times_m_is_not_m_times_n_by_refl() -> Unit {
    expect_error(|n: Nat, m: Nat| { let _p: Eq<Nat, n * m, m * n> = refl; 0 }, "E0010")
}
