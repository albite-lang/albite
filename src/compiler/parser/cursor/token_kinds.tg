// Token kind comparison and display name functions.

use lexer::token::{
    Token, TokenKind, token_kind, token_span,
    TokIdent, TokFn, TokLet, TokIf, TokElse, TokMatch, TokReturn,
    TokType, TokStruct, TokEnum, TokTrue, TokFalse,
    TokTheorem, TokLemma, TokAxiom, TokBy, TokHave, TokShow,
    TokAssume, TokForall, TokExists, TokProp, TokSorry, TokRefl,
    TokSubst, TokSym, TokTrans, TokCong, TokNatInd, TokNatRec,
    TokBool, TokNat, TokUnit, TokVoid, TokExtern, TokRef, TokMod,
    TokPub, TokUse, TokAs, TokCrate, TokUnderscore, TokTry, TokRegion,
    TokMut, TokLParen, TokRParen, TokLBrace, TokRBrace, TokLBracket, TokRBracket,
    TokLAngle, TokRAngle, TokComma, TokSemi, TokColon, TokColonColon,
    TokDot, TokDotDot, TokDotDotDot, TokArrow, TokFatArrow, TokAt,
    TokHash, TokQuestion, TokEq, TokBangEq, TokLe, TokGe,
    TokPlus, TokMinus, TokStar, TokSlash, TokPercent,
    TokAmp, TokAmpAmp, TokPipe, TokPipePipe, TokPipeRight, TokBang,
    TokCaret, TokTilde, TokEof, TokError, TokIntLit, TokStringLit
};

// ---------------------------------------------------------------------------
// TOKEN KIND EQUALITY
// ---------------------------------------------------------------------------

/// Compare two token kinds for equality.
/// For kinds with payloads (TokIdent, TokIntLit, etc.), only compares the variant.
pub fn token_kind_eq(a: TokenKind, b: TokenKind) -> Bool {
    token_kind_tag(a) == token_kind_tag(b)
}

/// A token kind's declaration index, payload ignored. One match naming every
/// constructor, so the self-host pads nothing: the old pairwise form was 93
/// gapped inner matches, ~8,500 padded slots (ADR 13.10.26k D6).
pub fn token_kind_tag(kind: TokenKind) -> Nat {
    match kind {
        TokIntLit(_) => 0,
        TokStringLit(_) => 1,
        TokCharLit(_) => 2,
        TokIdent(_) => 3,
        TokUnderscore() => 4,
        TokFn() => 5,
        TokLet() => 6,
        TokIf() => 7,
        TokElse() => 8,
        TokMatch() => 9,
        TokReturn() => 10,
        TokType() => 11,
        TokStruct() => 12,
        TokEnum() => 13,
        TokTrue() => 14,
        TokFalse() => 15,
        TokTheorem() => 16,
        TokLemma() => 17,
        TokAxiom() => 18,
        TokBy() => 19,
        TokHave() => 20,
        TokShow() => 21,
        TokAssume() => 22,
        TokForall() => 23,
        TokExists() => 24,
        TokProp() => 25,
        TokSorry() => 26,
        TokRefl() => 27,
        TokSubst() => 28,
        TokSym() => 29,
        TokTrans() => 30,
        TokCong() => 31,
        TokNatInd() => 32,
        TokNatRec() => 33,
        TokBool() => 34,
        TokNat() => 35,
        TokUnit() => 36,
        TokVoid() => 37,
        TokExtern() => 38,
        TokRef() => 39,
        TokMod() => 40,
        TokPub() => 41,
        TokUse() => 42,
        TokAs() => 43,
        TokTry() => 44,
        TokRegion() => 45,
        TokCrate() => 46,
        TokReserved(_) => 47,
        TokLParen() => 48,
        TokRParen() => 49,
        TokLBrace() => 50,
        TokRBrace() => 51,
        TokLBracket() => 52,
        TokRBracket() => 53,
        TokLAngle() => 54,
        TokRAngle() => 55,
        TokComma() => 56,
        TokSemi() => 57,
        TokColon() => 58,
        TokColonColon() => 59,
        TokDot() => 60,
        TokDotDot() => 61,
        TokDotDotDot() => 62,
        TokArrow() => 63,
        TokFatArrow() => 64,
        TokAt() => 65,
        TokHash() => 66,
        TokQuestion() => 67,
        TokEq() => 68,
        TokEqEq() => 69,
        TokBangEq() => 70,
        TokLe() => 71,
        TokGe() => 72,
        TokPlus() => 73,
        TokPlusPlus() => 74,
        TokMinus() => 75,
        TokStar() => 76,
        TokSlash() => 77,
        TokPercent() => 78,
        TokAmp() => 79,
        TokAmpAmp() => 80,
        TokPipe() => 81,
        TokPipePipe() => 82,
        TokPipeRight() => 83,
        TokBang() => 84,
        TokCaret() => 85,
        TokTilde() => 86,
        TokWhitespace() => 87,
        TokLineComment(_) => 88,
        TokBlockComment(_) => 89,
        TokDocComment(_) => 90,
        TokEof() => 91,
        TokError(_) => 92,
        TokMut() => 93
    }
}

// ---------------------------------------------------------------------------
// TOKEN KIND DISPLAY NAMES
// ---------------------------------------------------------------------------

/// Get a human-readable name for a token kind.
pub fn token_kind_name(k: TokenKind) -> String {
    match k {
        TokIntLit(_) => "integer literal",
        TokStringLit(_) => "string literal",
        TokCharLit(_) => "character literal",
        TokIdent(_) => "identifier",
        TokUnderscore() => "'_'",
        TokFn() => "'fn'",
        TokLet() => "'let'",
        TokIf() => "'if'",
        TokElse() => "'else'",
        TokMatch() => "'match'",
        TokReturn() => "'return'",
        TokType() => "'type'",
        TokStruct() => "'struct'",
        TokEnum() => "'enum'",
        TokTrue() => "'true'",
        TokFalse() => "'false'",
        TokTheorem() => "'theorem'",
        TokLemma() => "'lemma'",
        TokAxiom() => "'axiom'",
        TokBy() => "'by'",
        TokHave() => "'have'",
        TokShow() => "'show'",
        TokAssume() => "'assume'",
        TokForall() => "'forall'",
        TokExists() => "'exists'",
        TokProp() => "'Prop'",
        TokSorry() => "'sorry'",
        TokBool() => "'Bool'",
        TokNat() => "'Nat'",
        TokUnit() => "'Unit'",
        TokVoid() => "'Void'",
        TokExtern() => "'extern'",
        TokRef() => "'Ref'",
        TokMod() => "'mod'",
        TokReserved(_) => "reserved keyword",
        TokLParen() => "'('",
        TokRParen() => "')'",
        TokLBrace() => "'{'",
        TokRBrace() => "'}'",
        TokLBracket() => "'['",
        TokRBracket() => "']'",
        TokLAngle() => "'<'",
        TokRAngle() => "'>'",
        TokComma() => "','",
        TokSemi() => "';'",
        TokColon() => "':'",
        TokColonColon() => "'::'",
        TokDot() => "'.'",
        TokDotDot() => "'..'",
        TokDotDotDot() => "'...'",
        TokArrow() => "'->'",
        TokFatArrow() => "'=>'",
        TokAt() => "'@'",
        TokHash() => "'#'",
        TokQuestion() => "'?'",
        TokEq() => "'='",
        TokEqEq() => "'=='",
        TokBangEq() => "'!='",
        TokLe() => "'<='",
        TokGe() => "'>='",
        TokPlus() => "'+'",
        TokPlusPlus() => "'++'",
        TokMinus() => "'-'",
        TokStar() => "'*'",
        TokSlash() => "'/'",
        TokPercent() => "'%'",
        TokAmp() => "'&'",
        TokAmpAmp() => "'&&'",
        TokPipe() => "'|'",
        TokPipePipe() => "'||'",
        TokPipeRight() => "'|>'",
        TokBang() => "'!'",
        TokCaret() => "'^'",
        TokTilde() => "'~'",
        TokWhitespace() => "whitespace",
        TokLineComment(_) => "line comment",
        TokBlockComment(_) => "block comment",
        TokDocComment(_) => "doc comment",
        TokEof() => "end of file",
        TokError(_) => "error token",
        TokRefl() => "'refl'",
        TokSubst() => "'subst'",
        TokSym() => "'sym'",
        TokTrans() => "'trans'",
        TokCong() => "'cong'",
        TokNatInd() => "'natind'",
        TokNatRec() => "'natrec'",
        TokPub() => "'pub'",
        TokUse() => "'use'",
        TokAs() => "'as'",
        TokCrate() => "'crate'",
        TokTry() => "'try'",
        TokRegion() => "'region'",
        TokMut() => "'mut'"
    }
}
