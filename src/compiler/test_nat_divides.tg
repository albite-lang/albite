// The Tier 3 divisibility library is citable (ADR 7.10.26j AC 2, D5).
//
// Each lemma of nat_divides.tg cited in a typed `let`, at variables and at
// numerals, plus `expect_error` over a citation at the wrong arguments.
//
// Tier 3 (tg-test-tiers.toml): every assertion discharges at elaboration.
// The must-fail twin is `mustfail_nat_divides.tg`, checked by
// `make check-mustfail-fixtures`.

mod nat_divides;

// A hand-built hypothesis is `(witness, refl)`: `Divides<2, 4>` is
// `exists k: Nat. 4 == 2 * k`, and `2 * 2` computes to `4`.
//
// A citation at numerals states its conclusion as a plain numeral: a closed
// sum in a family argument converts when two types are compared
// (ADR 7.10.26i, which landed before this suite).
fn test_divides_refl_is_cited() -> Unit {
    let x: Nat = 3;
    let _r: nat_divides::Divides<x, x> = nat_divides::divides_refl(x);
    let _n: nat_divides::Divides<4, 4> = nat_divides::divides_refl(4);
    ()
}

fn test_divides_zero_is_cited() -> Unit {
    let x: Nat = 5;
    let _r: nat_divides::Divides<x, 0> = nat_divides::divides_zero(x);
    let _n: nat_divides::Divides<5, 0> = nat_divides::divides_zero(5);
    ()
}

fn test_one_divides_is_cited() -> Unit {
    let x: Nat = 7;
    let _r: nat_divides::Divides<1, x> = nat_divides::one_divides(x);
    let _n: nat_divides::Divides<1, 7> = nat_divides::one_divides(7);
    ()
}

fn test_divides_trans_is_cited() -> Unit {
    let h1: nat_divides::Divides<2, 4> = (2, refl);
    let h2: nat_divides::Divides<4, 12> = (3, refl);
    let _r: nat_divides::Divides<2, 12> = nat_divides::divides_trans(2, 4, 12, h1, h2);
    let x: Nat = 6;
    let h: nat_divides::Divides<x, x> = nat_divides::divides_refl(x);
    let _v: nat_divides::Divides<x, x> = nat_divides::divides_trans(x, x, x, h, h);
    ()
}

fn test_divides_add_is_cited() -> Unit {
    let h1: nat_divides::Divides<2, 4> = (2, refl);
    let h2: nat_divides::Divides<2, 6> = (3, refl);
    let _n: nat_divides::Divides<2, 10> = nat_divides::divides_add(2, 4, 6, h1, h2);
    let x: Nat = 3;
    let h: nat_divides::Divides<x, x> = nat_divides::divides_refl(x);
    let _r: nat_divides::Divides<x, x + x> = nat_divides::divides_add(x, x, x, h, h);
    ()
}

fn test_divides_mul_left_is_cited() -> Unit {
    let h: nat_divides::Divides<3, 6> = (2, refl);
    let _n: nat_divides::Divides<3, 30> = nat_divides::divides_mul_left(3, 6, 5, h);
    let x: Nat = 4;
    let y: Nat = 2;
    let hx: nat_divides::Divides<x, x> = nat_divides::divides_refl(x);
    let _r: nat_divides::Divides<x, y * x> = nat_divides::divides_mul_left(x, x, y, hx);
    ()
}

fn test_divides_mul_right_is_cited() -> Unit {
    let h: nat_divides::Divides<3, 6> = (2, refl);
    let _n: nat_divides::Divides<3, 30> = nat_divides::divides_mul_right(3, 6, 5, h);
    let x: Nat = 4;
    let y: Nat = 2;
    let hx: nat_divides::Divides<x, x> = nat_divides::divides_refl(x);
    let _r: nat_divides::Divides<x, x * y> = nat_divides::divides_mul_right(x, x, y, hx);
    ()
}

// A citation whose stated divisor is not the lemma's conclusion is refused.
fn test_wrong_citation_is_refused() -> Unit {
    expect_error(
        { let _r: nat_divides::Divides<2, 3> = nat_divides::divides_refl(2); () },
        "E0010",
    );
    ()
}
