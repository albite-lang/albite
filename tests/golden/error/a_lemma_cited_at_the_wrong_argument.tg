// A lemma cited at the wrong argument (ADR 30.9.26d AC 2): the expected type
// in the message is the SUBSTITUTED instance, `Eq<Nat, 0 + 3, 3>`, not the
// statement as written, `Eq<Nat, 0 + n, n>`.
fn add_zero_left(n: Nat) -> Eq<Nat, 0 + n, n> {
    natind(|k: Nat| Eq<Nat, 0 + k, k>, refl, fn(k: Nat, ih) => cong(|x: Nat| x + 1, ih), n)
}

fn cites_at_the_wrong_argument() -> Bool {
    let _p: Eq<Nat, 0 + 4, 4> = add_zero_left(3);
    true
}
