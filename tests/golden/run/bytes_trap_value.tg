// Golden test (ADR 3.10.26n AC 5): the evaluator's byte-value trap line —
// `error: byte value out of range`, native `tg_int_trap(9)`. 256 is the first
// value that is not a byte.
extern "C" fn tg_bytes_new(len: Nat) -> Nat
extern "C" fn tg_bytes_set(h: Nat, i: Nat, v: Nat) -> Nat

fn main() -> Nat { tg_bytes_set(tg_bytes_new(1), 0, 256) }
