// Golden test (ADR 13.10.26n AC 3): a failing `?` under a `let` is a non-tail
// `return` of the error, so the function returns `Err` there.
type Result<T, E> = Ok(T) | Err(E)

fn half(n: Nat) -> Result<Nat, Nat> {
    if n % 2 == 0 { Ok(n / 2) } else { Err(n) }
}

fn quarter(n: Nat) -> Result<Nat, Nat> {
    let h = half(n)?;
    let q = half(h)?;
    Ok(q + 1000)
}

fn settle(r: Result<Nat, Nat>) -> Nat {
    match r {
        Ok(v) => v,
        Err(e) => e + 500
    }
}

fn main() -> Nat {
    settle(quarter(6)) * 10000 + settle(quarter(8))
}
