// Golden test (ADR 13.10.26o AC 3): a `try` in tail position of a function
// with the same `Result` type, where returning from the `try` and returning
// from `g` coincide. g(3) yields Err(3), so main is 3 + 500.
type Result<T, E> = Ok(T) | Err(E)

fn half(n: Nat) -> Result<Nat, Nat> {
    if n % 2 == 0 { Ok(n / 2) } else { Err(n) }
}

fn g(n: Nat) -> Result<Nat, Nat> {
    try { half(n)? + 10 }
}

fn main() -> Nat {
    match g(3) {
        Ok(v) => v,
        Err(e) => e + 500
    }
}
