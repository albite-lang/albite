// Golden test (ADR 13.10.26o AC 3): a failing `?` inside a `try`, in a
// function returning `Nat`, yields the `try`'s `Err` and stays in `f`.
// f(3) = 3 + 500 and f(4) = 2 + 10, so main is 503 + 12 * 1000.
type Result<T, E> = Ok(T) | Err(E)

fn half(n: Nat) -> Result<Nat, Nat> {
    if n % 2 == 0 { Ok(n / 2) } else { Err(n) }
}

fn f(n: Nat) -> Nat {
    let r: Result<Nat, Nat> = try { half(n)? + 10 };
    match r {
        Ok(v) => v,
        Err(e) => e + 500
    }
}

fn main() -> Nat {
    f(3) + f(4) * 1000
}
