// `albite test --format junit` (ADR 30.9.26k AC 5): one testcase per
// verdict the runner can reach here, in one document. `time` is normalised to
// 0.000 by the golden runner (D9); the failing test's assertion diff rides in
// its `<failure>`, and the printing test's markup is escaped in `<system-out>`.

extern "C" fn tg_assert_eq_nat(left: Nat, right: Nat) -> Unit
extern "C" fn tg_never_executable_probe(x: Nat) -> Nat
extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

fn assert_eq_nat(a: Nat, b: Nat) -> Unit { tg_assert_eq_nat(a, b) }
fn stuck_value() -> Nat { tg_never_executable_probe(1) }

fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

pub fn test_passes() -> Unit { assert_eq_nat(2 + 2, 4) }

pub fn test_fails() -> Unit { assert_eq_nat(2, 3) }

pub fn test_asserts_nothing() -> Unit { assert_eq_nat(stuck_value(), 1) }

pub fn test_does_not_finish() -> Unit {
    let _first = assert_eq_nat(1, 1);
    let _stuck = stuck_value();
    assert_eq_nat(2, 2)
}

pub fn test_prints_markup() -> Unit {
    println("hello <b> & ]]> from a test body");
    assert_eq_nat(1, 1)
}
