// tests/nat_div_zero_run.tg — ADR 9.10.26g AC 3 parity fixture
//
// `Nat` `/` and `%` by zero are `0` on the evaluator and in the kernel; this
// program prints them by a run-time zero, a run-time non-zero and a constant
// zero, so `tungsten diff exec` compares the evaluator against the native
// lowering. The run-time divisors come from a string's length, which no
// builder fold can see, so `--emit-llvm` shows them as `i64` registers and a
// red here is the lowering, not a constant fold.
//
// Standalone on purpose, like `int_parity_run.tg`: it declares its own
// externs so the fixture costs a handful of symbols, not the compiler.

extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

fn digit(d: Nat) -> String {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
    else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
    else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
    else { "9" }
}

/// Render a Nat in decimal.
#[partial]
fn nat_to_string(n: Nat) -> String {
    if n < 10 {
        digit(n)
    } else {
        nat_to_string(n / 10) ++ digit(n % 10)
    }
}

// `show` is a proof keyword (`tungsten explain keywords show`), hence `emit`.
fn emit(label: String, n: Nat) -> Unit {
    println(label ++ " = " ++ nat_to_string(n))
}

fn main() -> Unit {
    let zero = tg_string_len_internal("");
    let three = tg_string_len_internal("abc");
    let seven = tg_string_len_internal("abcdefg");

    // Run-time zero divisor: the guarded case.
    emit("div_by_runtime_zero", seven / zero);
    emit("mod_by_runtime_zero", seven % zero);

    // Run-time non-zero divisor: the guard must not change the answer.
    emit("div_by_runtime_three", seven / three);
    emit("mod_by_runtime_three", seven % three);

    // Constant zero divisor, run-time dividend: settled at build time.
    emit("div_by_const_zero", seven / 0);
    emit("mod_by_const_zero", seven % 0);

    // Zero divided by zero.
    emit("zero_div_zero", zero / zero);
    emit("zero_mod_zero", zero % zero);
    println("done")
}
