// tests/native_core_bytes_run.tg — ADR 4.10.26n AC 7, the native-against-native battery
//
// What the evaluator cannot represent: a `String` holding half of a two-byte
// character. Rust's `tg_string_concat` returns such bytes unchanged, so the
// export written in Tungsten must too — which is why it converts through the
// UNCHECKED intrinsic (D5). `make check-native-core-parity` compiles this file
// twice, `ALBITE_NATIVE_CORE=off` and `=all`, and the two binaries' stdout
// must be byte-identical. Never run it under `diff exec`: the evaluator cannot
// hold a split character at all.
//
// The halves arrive as arguments 1 and 2 — `check-native-core-split-bytes`
// passes the lone bytes C3 and A9 — because a `substring` cut inside a
// character traps on every reader (ADR 16.10.26h D5), and
// `tg_cstring_to_string` copies an argument's bytes without checking them.

extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit
extern "C" fn tg_argv(index: Nat) -> Nat
extern "C" fn tg_cstring_to_string(s: Nat) -> String

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

fn digit(d: Nat) -> String {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
    else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
    else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
    else { "9" }
}

/// Render a Nat in decimal.
#[partial]
fn nat_to_string(n: Nat) -> String {
    if n < 10 { digit(n) } else { nat_to_string(n / 10) ++ digit(n % 10) }
}

fn print_result(label: String, text: String) -> Unit {
    println(label ++ " [" ++ text ++ "] " ++ nat_to_string(string_len(text)))
}

fn main() -> Unit {
    // "é" is the two bytes C3 A9: each half alone is invalid UTF-8.
    let lead = tg_cstring_to_string(tg_argv(1));
    let trail = tg_cstring_to_string(tg_argv(2));
    print_result("split-left", lead ++ "x");
    print_result("split-right", "x" ++ trail);
    // Rejoining the halves restores the character.
    print_result("rejoined", lead ++ trail);
    print_result("split-both-sides", trail ++ lead);
    print_result("split-empty", lead ++ "");
    // 6.10.26n AC 5: an owned `++` whose left, a dead `++` result, holds a
    // split character: the adoption must keep its bytes unchanged.
    let split_heap = lead ++ "y";
    print_result("owned-split-left", split_heap ++ trail);
    print_result("owned-split-nested", (trail ++ lead) ++ lead ++ trail);
    println("done")
}
