// tests/native_core_owned_grow_run.tg — ADR 16.10.26j AC 4, the amortised grow's `diff exec` battery
//
// Under `ALBITE_NATIVE_CORE=all` every owned `++` here grows its left
// operand's block through `__albite_realloc_amortised`: in place while the
// allocator's usable size holds the result, and otherwise by a `realloc(3)`
// that keeps room for the next grows. The seeds (1–40 bytes), pieces (1–300)
// and chains (1, 7 and 20 owned grows) cross both paths, at many sizes.
// `tungsten diff exec` runs it on the evaluator AND natively and compares
// stdout; `check-native-core-parity` runs it with `ALBITE_ARENA` unset and
// at `bump:1`, where the grow is the bump arena's exact one. Each line prints
// a result's byte length and a position-weighted checksum of its bytes, so a
// grow that loses, moves or misplaces a byte is a divergence.
//
// Standalone on purpose: it declares its own externs.

extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

fn digit(d: Nat) -> String {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
    else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
    else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
    else { "9" }
}

/// Render a Nat in decimal.
#[partial]
fn nat_to_string(n: Nat) -> String {
    if n < 10 { digit(n) } else { nat_to_string(n / 10) ++ digit(n % 10) }
}

/// `n` ASCII letters starting at letter `k`, so pieces differ by content.
#[partial]
fn letters(k: Nat, n: Nat) -> String {
    if n == 0 { "" } else { substring("abcdefghijklmnopqrstuvwxyz", (k + n) % 26, 1) ++ letters(k, n - 1) }
}

/// The sum of each byte times its 1-based position.
#[partial]
fn weighted_checksum(s: String, i: Nat, sum: Nat) -> Nat {
    if i == string_len(s) { sum } else { weighted_checksum(s, i + 1, sum + char_at(s, i) * (i + 1)) }
}

/// One non-owned join (the seed is a live parameter), then one owned grow.
fn owned_chain_1(seed: String, piece: String) -> String {
    let s1 = seed ++ piece;
    s1 ++ piece
}

/// One non-owned join, then seven owned grows, as `string_concat_owned.tg`.
fn owned_chain_7(seed: String, piece: String) -> String {
    let s1 = seed ++ piece;
    let s2 = s1 ++ piece;
    let s3 = s2 ++ piece;
    let s4 = s3 ++ piece;
    let s5 = s4 ++ piece;
    let s6 = s5 ++ piece;
    let s7 = s6 ++ piece;
    s7 ++ piece
}

/// One non-owned join, then twenty owned grows: far past any first slack.
fn owned_chain_20(seed: String, piece: String) -> String {
    let s1 = seed ++ piece;
    let s2 = s1 ++ piece;
    let s3 = s2 ++ piece;
    let s4 = s3 ++ piece;
    let s5 = s4 ++ piece;
    let s6 = s5 ++ piece;
    let s7 = s6 ++ piece;
    let s8 = s7 ++ piece;
    let s9 = s8 ++ piece;
    let s10 = s9 ++ piece;
    let s11 = s10 ++ piece;
    let s12 = s11 ++ piece;
    let s13 = s12 ++ piece;
    let s14 = s13 ++ piece;
    let s15 = s14 ++ piece;
    let s16 = s15 ++ piece;
    let s17 = s16 ++ piece;
    let s18 = s17 ++ piece;
    let s19 = s18 ++ piece;
    let s20 = s19 ++ piece;
    s20 ++ piece
}

/// One line: `<label> <byte length> <checksum>`.
fn print_measure(label: String, text: String) -> Unit {
    println(label ++ " " ++ nat_to_string(string_len(text)) ++ " " ++ nat_to_string(weighted_checksum(text, 0, 0)))
}

/// The three chains over one seed and one piece length.
fn print_chains(seed_len: Nat, piece_len: Nat) -> Unit {
    let seed = letters(0, seed_len);
    let piece = letters(piece_len, piece_len);
    let label = nat_to_string(seed_len) ++ "+" ++ nat_to_string(piece_len) ++ "x";
    print_measure(label ++ "1", owned_chain_1(seed, piece));
    print_measure(label ++ "7", owned_chain_7(seed, piece));
    print_measure(label ++ "20", owned_chain_20(seed, piece))
}

/// Every piece length over one seed length.
fn print_seed(seed_len: Nat) -> Unit {
    print_chains(seed_len, 1);
    print_chains(seed_len, 7);
    print_chains(seed_len, 64);
    print_chains(seed_len, 100);
    print_chains(seed_len, 256);
    print_chains(seed_len, 300)
}

fn main() -> Unit {
    print_seed(1);
    print_seed(3);
    print_seed(4);
    print_seed(17);
    print_seed(40);
    println("done")
}
