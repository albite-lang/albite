// tests/native_core_parity_run.tg — ADR 4.10.26n AC 7, 6.10.26n AC 5, the `diff exec` battery
//
// Every `++` here is lowered to `tg_string_concat` under
// `ALBITE_NATIVE_CORE=off` and to `tg_native_string_concat`, the export
// written in Tungsten (`src/native_core/string.tg`), under `=on`. `tungsten
// diff exec` runs it on the evaluator AND natively and compares stdout, so a
// port that sizes, blits or converts wrongly is a divergence. Each line prints
// a result and its byte length.
//
// Every input here is valid UTF-8, because an evaluator `String` must be; the
// split multi-byte case lives in `native_core_bytes_run.tg`, compared native
// against native. Standalone on purpose: it declares its own externs.

extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

fn digit(d: Nat) -> String {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
    else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
    else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
    else { "9" }
}

/// Render a Nat in decimal.
#[partial]
fn nat_to_string(n: Nat) -> String {
    if n < 10 { digit(n) } else { nat_to_string(n / 10) ++ digit(n % 10) }
}

/// One line: `<label> [<text>] <byte length>`.
fn print_result(label: String, text: String) -> Unit {
    println(label ++ " [" ++ text ++ "] " ++ nat_to_string(string_len(text)))
}

/// Only the length, for a result too long to print.
fn print_length(label: String, text: String) -> Unit {
    println(label ++ " " ++ nat_to_string(string_len(text)))
}

/// `s` doubled `n` times: `len(s) * 2^n` bytes.
#[partial]
fn doubled(s: String, n: Nat) -> String {
    if n == 0 { s } else { doubled(s ++ s, n - 1) }
}

/// `acc` grown `n` times by a let-bound chain (ADR 6.10.26n AC 5): the
/// first `++` takes the live parameter, and each one after it the previous
/// `++`'s dead result, so under `all` every later step is the owned export
/// growing its left operand's block.
#[partial]
fn owned_grow(acc: String, piece: String, n: Nat) -> String {
    if n == 0 { acc } else {
        let first = acc ++ piece;
        let second = first ++ "-";
        owned_grow(second ++ piece, piece, n - 1)
    }
}

/// An index no string reaches, and one a signed compare would read as negative.
fn two_to_the_63() -> Nat { 9223372036854775808 }

fn main() -> Unit {
    print_result("empty-left", "" ++ "abc");
    print_result("empty-right", "abc" ++ "");
    print_result("both-empty", "" ++ "");
    print_result("ascii", "hello, " ++ "world");
    print_result("multi-byte", "caf" ++ "é" ++ "—✓");
    // 2^20 bytes: a 1 MiB result built from nested concatenations.
    let mib = doubled("x", 20);
    print_length("one-mib", mib);
    print_length("one-mib-plus", mib ++ "!");
    // An inner result feeding the owned path: the left operand is a dead
    // heap temporary, so the second `++` is `tg_string_concat_owned`.
    let chain = ("a" ++ "b") ++ "c" ++ "d";
    print_result("owned-chain", chain);
    // 6.10.26n AC 5: a long owned chain, and one over multi-byte characters.
    print_length("owned-long", owned_grow("", "xyz", 3000));
    print_result("owned-multi-byte", owned_grow("<", "é✓", 6));
    print_result("owned-empty-heap-left", ("" ++ "") ++ "q");
    // `substring` on character boundaries copies whole characters.
    let word = "cafe café";
    print_result("substring-boundaries", substring(word, 5, 5) ++ substring(word, 0, 5));
    // ADR 13.10.26j: offsets count bytes on every reader, so a multi-byte
    // character BEFORE the offset shifts it by its width. `ï` is bytes 2..4.
    let naive = "naïve café";
    print_result("substring-after-multi-byte", substring(naive, 0, 4) ++ "|" ++ substring(naive, 4, 3));
    println("char-at-multi-byte " ++ nat_to_string(char_at(naive, 2)) ++ " " ++ nat_to_string(char_at(naive, 5)));
    // ADR 16.10.26i: past the end is 0 on every reader, and native code reads
    // nothing there. 12 is the length (the boundary), 99 lands on whatever
    // follows the literal, 2^63 must compare as large, not negative.
    println("char-at-past-the-end " ++ nat_to_string(char_at(naive, 12)) ++ " " ++ nat_to_string(char_at(naive, 99)) ++ " " ++ nat_to_string(char_at(naive, two_to_the_63())));
    println("done")
}
