// A dependent hypothesis (ADR 7.10.26n D10): `h: (n: Nat) -> Eq<…>`, the
// surface dependent function type, applied at `k`, and a lambda passed for
// one. No family and no tactic block, so the self-host meets the binder
// itself.
//
// The bootstrap accepts this file; `tungsten1` refuses it, which is the
// battery row's recorded refusal (Q7: a refusal, never an acceptance) until
// the self-host mirrors the surface.

pub theorem add_zero_everywhere(h: (n: Nat) -> Eq<Nat, n + 0, n>, k: Nat) -> Eq<Nat, k + 0, k> { h(k) }

pub theorem lift(k: Nat) -> Eq<Nat, k + 0, k> { add_zero_everywhere(|m: Nat| refl, k) }
