// tests/small_sums_run.tg — ADR 2.10.26h AC 4 parity fixture
//
// After 2.10.26h a sum of at most 8 bytes crosses a `$direct_mt` entry as one
// integer — packed by the `$direct` shim and the self-edge, unpacked at the
// callee's entry and in the shim's result. A word packed or unpacked wrongly
// reads back as a different constructor or a different payload. The evaluator
// has no `$direct_mt`, so `tungsten diff exec` compares a changed native side
// against an unchanged reference. Run twice by
// `bootstrap/tests/diff_exec_e2e.rs`: `ALBITE_ARENA` unset, and `bump:1`.
//
// It covers:
//   - `Color`, three constructors, passed and returned through a
//     self-recursive function, every constructor reached;
//   - `Flag = Off | On(Bool)`, a 1-byte payload (its blob has padding), and
//     `Shade = Plain | Tinted(Color)`, a 4-byte payload — both words;
//   - an early `return` from a word-returning function;
//   - a word beside an indirect blob, with an sret return, in one signature;
//   - a word stored into, and matched back out of, a recursive value.
//
// Standalone, like `nullary_cells_run.tg`: it declares its own externs.

extern "C" fn tg_println(s: Nat, len: Nat) -> Unit
extern "C" fn tg_string_to_cstring(s: String) -> Nat
extern "C" fn tg_string_len_internal(s: String) -> Nat
extern "C" fn tg_free_string(s: Nat) -> Unit

pub fn println(s: String) -> Unit {
    let c = tg_string_to_cstring(s);
    let len = tg_string_len_internal(s);
    tg_println(c, len);
    tg_free_string(c)
}

/// Render a Nat in decimal, so a count can be printed and compared.
#[partial]
fn nat_to_string(n: Nat) -> String {
    if n < 10 {
        digit(n)
    } else {
        nat_to_string(n / 10) ++ digit(n % 10)
    }
}

fn digit(d: Nat) -> String {
    if d == 0 { "0" } else if d == 1 { "1" } else if d == 2 { "2" }
    else if d == 3 { "3" } else if d == 4 { "4" } else if d == 5 { "5" }
    else if d == 6 { "6" } else if d == 7 { "7" } else if d == 8 { "8" }
    else { "9" }
}

// --- Color: three constructors through a self-recursive function ----------

type Color = Red | Green | Blue

fn color_name(c: Color) -> String {
    match c {
        Red() => "red",
        Green() => "green",
        Blue() => "blue"
    }
}

fn next_color(c: Color, step: Nat) -> Color {
    match c {
        Red() => if step == 0 { Red } else { Green },
        Green() => if step == 0 { Green } else { Blue },
        Blue() => if step == 0 { Blue } else { Red }
    }
}

/// Advance `c` by one, `n` times: a word in, a word out, a word on the
/// self-edge.
#[partial]
fn cycle(c: Color, n: Nat) -> Color {
    if n == 0 { c } else { cycle(next_color(c, 1), n - 1) }
}

// --- Flag (1-byte payload) and Shade (4-byte payload) ---------------------

type Flag = Off | On(Bool)

type Shade = Plain | Tinted(Color)

fn flag_name(f: Flag) -> String {
    match f {
        Off() => "off",
        On(b) => if b { "on(true)" } else { "on(false)" }
    }
}

fn shade_name(s: Shade) -> String {
    match s {
        Plain() => "plain",
        Tinted(c) => "tinted(" ++ color_name(c) ++ ")"
    }
}

/// Toggle a flag `n` times: `Off → On(true) → On(false) → Off`.
#[partial]
fn toggle(f: Flag, n: Nat) -> Flag {
    if n == 0 {
        f
    } else {
        let next = match f {
            Off() => On(true),
            On(b) => if b { On(false) } else { Off }
        };
        toggle(next, n - 1)
    }
}

/// Darken a shade `n` times, cycling its colour; `Plain` becomes `Tinted(Red)`.
#[partial]
fn darken(s: Shade, n: Nat) -> Shade {
    if n == 0 {
        s
    } else {
        let next = match s {
            Plain() => Tinted(Red),
            Tinted(c) => Tinted(next_color(c, 1))
        };
        darken(next, n - 1)
    }
}

// --- An early return from a word-returning function ------------------------

fn is_on_true(f: Flag) -> Bool {
    match f {
        Off() => false,
        On(x) => x
    }
}

// The `return` sits in an `if`, not a statement-position `match`: the
// evaluator drops an early return from the latter (it prints `b`), which
// predates 2.10.26h and would mask the word path behind an unrelated
// divergence.
fn first_on(a: Flag, b: Flag) -> Flag {
    if is_on_true(a) { return On(true) } else { b }
}

// --- A word beside an indirect blob, with an sret return -------------------

type Big = Nothing | Both(Nat, Nat)

/// `c` is a word, `big` a 20-byte indirect buffer, and the result an sret.
#[partial]
fn tally(c: Color, big: Big, n: Nat) -> Big {
    if n == 0 {
        big
    } else {
        let bumped = match big {
            Nothing() => Both(0, 0),
            Both(reds, others) => match c {
                Red() => Both(reds + 1, others),
                Green() => Both(reds, others + 1),
                Blue() => Both(reds, others + 10)
            }
        };
        tally(next_color(c, 1), bumped, n - 1)
    }
}

fn big_name(b: Big) -> String {
    match b {
        Nothing() => "nothing",
        Both(x, y) => "both(" ++ nat_to_string(x) ++ "," ++ nat_to_string(y) ++ ")"
    }
}

// --- Words stored in, and matched out of, a recursive value ----------------

type Palette = PEnd | PCons(Color, Shade, Palette)

#[partial]
fn paint(c: Color, n: Nat) -> Palette {
    if n == 0 { PEnd } else { PCons(c, Tinted(c), paint(next_color(c, 1), n - 1)) }
}

fn palette_names(p: Palette) -> String {
    match p {
        PEnd() => "",
        PCons(c, s, rest) => color_name(c) ++ "/" ++ shade_name(s) ++ " " ++ palette_names(rest)
    }
}

// Emits exactly:
//   "red" "green" "blue" "red"     — cycle(Red, 0..3): every constructor
//   "off" "on(true)" "on(false)" "off"
//   "plain" "tinted(red)" "tinted(green)" "tinted(blue)"
//   "on(true)" "off" "on(false)"   — first_on: early return, then fall-through
//   "both(1,11)"                   — tally(Red, Nothing, 4)
//   "red/tinted(red) green/tinted(green) blue/tinted(blue) "
fn emit() -> Unit {
    println(color_name(cycle(Red, 0)));
    println(color_name(cycle(Red, 1)));
    println(color_name(cycle(Red, 2)));
    println(color_name(cycle(Red, 3)));
    println(flag_name(toggle(Off, 0)));
    println(flag_name(toggle(Off, 1)));
    println(flag_name(toggle(Off, 2)));
    println(flag_name(toggle(Off, 3)));
    println(shade_name(darken(Plain, 0)));
    println(shade_name(darken(Plain, 1)));
    println(shade_name(darken(Plain, 2)));
    println(shade_name(darken(Plain, 3)));
    println(flag_name(first_on(On(true), On(false))));
    println(flag_name(first_on(Off, Off)));
    println(flag_name(first_on(On(false), On(false))));
    println(big_name(tally(Red, Nothing, 4)));
    println(palette_names(paint(Red, 3)))
}

fn main() -> Nat {
    emit();
    0
}
